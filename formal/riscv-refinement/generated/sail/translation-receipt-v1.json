  "normalization_rules": {
    "collapse-single-statement-do": "a do-block holding exactly one expression statement denotes that expression",
    "inline-pure-let-bindings": "let-bound expression names are inlined into the expressions that use them",
    "monadic-bind-is-observation": "a monadic bind of a whitelisted reader denotes an observation of pre-state, never a state change",
    "next-pc-sequential-unless-set": "absence of a next-pc effect denotes the sequential pc + 4 retirement",
    "register-write-via-wX_bits": "wX_bits target value denotes the single architectural register write",
    "retirement-from-terminal-pure": "the terminal pure expression carries the retirement classification",
    "selector-match-feeds-effect": "a generated effect whose value is selected by an inline monadic match is normalized by feeding each alternative directly to that effect",
    "selector-match-is-total": "the single match on the instruction selector supplies one alternative per selector and no wildcard"
  },
