  "source_mapping_review": "Reviewed the relocated x^5 Fill.sbox/Evaluate.sbox equations, shared round/matrix context, framework nonfinal same-row differences and final previous-row plus claim shift. The interaction writer still forms each row's batch fractions, sums their final cumulative value into claimed_sum, and subtracts claimed_sum/trace_size from the cross-row prefix. QM31 add/sub map to four M31 coordinates. Input validation, division, batch-fraction normalization, wide-batch domain attribution, and whole-protocol soundness remain outside these local lemmas.",
  "mappings": [
    {
      "zig": "poseidon2_universal_degree3_v1.zig: Fill.sbox and poseidon2_universal_equations_v1.zig: Evaluate.sbox",
      "lean": "RiscvRefinement.Recursion.CompactPoseidon.accepted_output",
      "equations": [
        "square - x*x = 0",
        "fifth - x*(square*square) = 0"
      ],
      "result": "fifth equals x^5 modulo2147483647 for every canonicalM31input; no enabler premise"
    },
    {
      "zig": "poseidon2_degree3_schedule.zig: walk/fullRound and poseidon2_matrix.zig: externalMatrix*/internalMatrix*",
      "lean": "RiscvRefinement.Recursion.CompactPoseidon.unchanged_context",
      "result": "pointwise S-box equality substitutes into an unchangedcontext; concrete schedule/constant/Zig translation remains a reviewed mapping, not a formal refinement"
    },
    {
      "zig": "universal_typed_verifier_component.zig: evaluateBaseRowInto/frameworkConstraint",
      "lean": "RiscvRefinement.Recursion.FrameworkBoundary.row_boundary",
      "result": "same-row nonfinal cumulative differences telescope, only finalbatch includespreviousrow andshift; premise normalizedbatchfractions requiresnonzero denominators"
    },
    {
      "zig": "framework_interaction.zig: generatePreparedIntoInternal prefix loop and zero finalprefix check",
      "lean": "RiscvRefinement.Recursion.FrameworkBoundary.secure_claim_boundary",
      "result": "four-coordinate cyclic final-prefix sum equals claim when trace_size*shift=claim; arbitrary common prefix offset allowed; inversion/primality/extension-field implementation not proven here"
    }
  ],
