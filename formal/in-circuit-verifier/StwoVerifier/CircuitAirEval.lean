/-
**Executable evaluation of the circuit-AIR composition DAG.**

`CircuitAirData` (generated by `harness/airdump.zig`) is the flattened
denotation of the in-circuit `computeCompositionPolynomial` with the
11-component circuit table: one arithmetic DAG over the composition
inputs (the OODS samples and challenges), up to the final division by
the trace coset's vanishing polynomial, plus the recorded `eq` side
conditions (the generated components' fixed-size checks).

This file evaluates that DAG over `QM31`. `composition` adds the
vanishing division (which depends on the proof's log trace size), so

  `composition inputs logTrace`

is the value the circuit AIR's `Air.evalComposition` must produce, and
`eqConditionsHold` is the side condition battery the in-circuit verify
enforces as `eq` gates. `harness/airvectors.json` (same tool) carries
differential vectors whose expected outputs come from the real Zig
`computeCompositionPolynomial` running eagerly over values; `lake exe
aircheck` replays them against these definitions.
-/
import StwoVerifier.CircuitAirData
import StwoVerifier.Fields

namespace StwoVerifier.CircuitAir

open CircuitAirData

/-- Total inverse: the field inverse, `0` at `0` (every recorded `inv`
node's operand is constrained nonzero by the surrounding circuit). -/
def qinv (x : QM31) : QM31 := (x.inv?).getD QM31.zero

/-- One DAG node's value from the inputs and the earlier node values. -/
def dagStep (inputs : Array QM31) (vals : Array QM31) (n : Nat × Nat × Nat) : QM31 :=
  match n with
  | (0, a, _) =>
    let c := consts.getD a (0, 0, 0, 0)
    QM31.fromM31s (c.1 : Nat) (c.2.1 : Nat) (c.2.2.1 : Nat) (c.2.2.2 : Nat)
  | (1, a, _) => inputs.getD a QM31.zero
  | (2, a, b) => vals.getD a QM31.zero + vals.getD b QM31.zero
  | (3, a, b) => vals.getD a QM31.zero - vals.getD b QM31.zero
  | (4, a, b) => vals.getD a QM31.zero * vals.getD b QM31.zero
  | (_, a, _) => qinv (vals.getD a QM31.zero)

/-- Evaluate the DAG: node values in node order. -/
def evalNodes (inputs : Array QM31) : Array QM31 :=
  nodes.foldl (fun vals n => vals.push (dagStep inputs vals n)) (Array.mkEmpty nodes.size)

/-- The accumulated constraint sum (pre-vanishing-division). -/
def constraintSum (inputs : Array QM31) : QM31 :=
  (evalNodes inputs).getD output QM31.zero

/-- The recorded `eq` side conditions all hold. -/
def eqConditionsHold (inputs : Array QM31) : Bool :=
  let vals := evalNodes inputs
  eqs.all fun p => QM31.eql (vals.getD p.1 QM31.zero) (vals.getD p.2 QM31.zero)

/-- `coset_vanishing_poly`: `pi^(logTrace - 1)` of `x`, `pi x = 2x² − 1`. -/
def vanishing (x : QM31) : Nat → QM31
  | 0 => x
  | n + 1 => let v := vanishing x n; v * v + v * v - QM31.one

/-- The full composition value: the constraint sum divided by the trace
coset's vanishing polynomial at the OODS point's x. -/
def composition (inputs : Array QM31) (logTrace : Nat) : QM31 :=
  constraintSum inputs * qinv (vanishing (inputs.getD atomPtX QM31.zero) (logTrace - 1))

end StwoVerifier.CircuitAir
