+test "half-coset cost includes compact columns output tile and global bucket" {
+    const a = std.testing.allocator;
+    const columns = [_]Column{.{ .log = 22, .direct = true }} ** 167;
+    const legacy = Role{ .trace_log = 22, .eval_log = 24, .columns = &columns, .masks = 116, .parameters = 7, .constraints = 16 };
+    var tiled = legacy;
+    tiled.coset_columns = 116;
+    try std.testing.expectEqual(@as(u64, 11240738728), (try arenaWords(legacy)) * 4);
+    try std.testing.expectEqual(@as(u64, 4177526784), (try arenaWords(tiled)) * 4);
+    var plan = try init(a, .{ .roles = &.{tiled}, .log = 24, .split = 1, .beta = 1, .separate_coefficients = true, .constraints = 16 });
+    defer plan.deinit(a);
+    var bucket_bytes: u64 = 0;
+    var log_bytes: u64 = 0;
+    for (plan.events.items) |event| {
+        if (event.kind == .bucket) bucket_bytes += event.bytes;
+        if (event.kind == .direct_logs) log_bytes += event.bytes;
+    }
+    try std.testing.expectEqual(@as(u64, 8 * (1 << 24) * 4), bucket_bytes);
+    try std.testing.expectEqual(@as(u64, 116 * 4), log_bytes);
+    tiled.auxiliary = .last;
+    try std.testing.expectError(error.InvalidCompositionGeometry, arenaWords(tiled));
+}
