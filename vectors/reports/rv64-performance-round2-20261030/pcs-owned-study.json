  "gates_completed": [
    "Identical commitment root and transcript digest across all four arms.",
    "Identical retained minimal coefficients and 70-query authenticated Merkle opening digest.",
    "Independent core MerkleVerifier accepts every opening.",
    "Owned coefficient pointers remain inside the original arena; provider originals unchanged.",
    "Total-column boundary cases 2,64,65,127,128 pass using a uniform existing CPU backend policy.",
    "Exhaustive allocation failures release source exactly once for both 2-column and 128-column owned routes."
  ],
  "interpretation": [
    "Prepared CPU policy alone and batch scheduling account for part of the observed commitment difference; ownership is isolated by comparing policy_borrowed64 with policy_owned_arena.",
    "One ordered run does not establish a stable speedup or a whole-job improvement.",
    "Post-commit residency is unchanged because every route retains the same coefficients. Ownership reduces the commitment transient, not necessarily the whole-job peak.",
    "Source matrix initialization is separately timed and included in charged memory. No extra wide copy is hidden in the owned commit timing."
  ],
  "architecture": [
    "One source arena contains the CPU matrix plus copies of the small provider multiplicities. Provider originals remain live for challenge-dependent generation.",
    "The existing commitOwnedWithRecorderAndBacking API consumes descriptor and backing ownership on success and failure.",
    "Uniform CPU wide_preparation/source_trace_arena policy avoids frontend dispatch thresholds.",
    "Integration must retain the original complete backing slice and reject mismatched commit allocators before transfer.",
    "No field, transcript, lookup security, domain geometry, or proof format change is intended."
  ],
  "limits": [
    "No AIR/FRI/PoW or complete execution STARK is measured by this microbenchmark.",
    "Charged heap excludes worker stacks, allocator bookkeeping and process RSS.",
    "Raw source values are deterministic random M31, not captured RV64 witness data."
  ],
  "integration": {
    "scope": "CPU main plus small provider multiplicity copies only; interactions keep borrowed streaming commit",
    "cpu_policy": {
      "wide_preparation": true,
      "source_trace_arena": true
    },
    "ownership": "Trace holds original complete allocation until successful takeMainForCommit; PCS consumes transferred descriptors/backing on success and error; provider original vectors remain independent.",
    "admission": "Allocator ptr/vtable must match Trace allocator before mutation. Shape and allocation failures before transfer preserve Trace ownership.",
    "focused_gates": [
      "zig build test-riscv64-full-capture -Doptimize=ReleaseSafe",
      "zig build test-riscv64-full-proof -Doptimize=ReleaseSafe",
      "zig build test-riscv64-pcs-owned test-riscv64-pcs-commit -Doptimize=ReleaseSafe"
    ],
    "whole_job_peak_claim": false
  }
