+    input.extras = &.{ .{ .kind = .bulk, .log = 5, .width = 19, .count = 23, .input_words_per_record = 0 }, .{ .kind = .sponge, .log = 5, .width = 27, .count = 3, .input_words_per_record = 0 } };
