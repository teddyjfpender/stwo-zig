+// M7 numerical-only graphs. Callers validate every CURRENT scoped lease before
+// lookup/replay; this cache owns executable metadata, never device allocations.
+// Capture is restricted to one lane and owner thread, with no dependency slots.
+extern "C" int stwo_rv64_graph_cache_lookup_on(
+    void *handle, uint32_t lane, const uint8_t *key, void **out_exec) {
+    if (!key || !out_exec) return int(cudaErrorInvalidValue);
+    *out_exec = nullptr;
+    StwoNativeCudaContext *context = nullptr;
+    auto status = require_context(handle, &context);
+    if (status != cudaSuccess) return int(status);
+    if (context->capture_active || lane >= context->lane_count)
+        return int(STWO_CUDA_ERROR_INVALID_RESOURCE_HANDLE);
+    for (auto &graph : context->proof_graphs) {
+        if (graph.exec && graph.lane == lane && !std::memcmp(graph.key, key, 32)) {
+            graph.age = ++context->proof_graph_clock;
+            *out_exec = reinterpret_cast<void *>(graph.exec);
+            break;
+        }
+    }
+    return 0;
+}
+
+extern "C" int stwo_rv64_graph_capture_begin_on(void *handle, uint32_t lane) {
+    StwoNativeCudaContext *context = nullptr;
+    auto status = require_context(handle, &context);
+    if (status != cudaSuccess) return int(status);
+    if (context->capture_active || lane >= context->lane_count)
+        return int(STWO_CUDA_ERROR_INVALID_RESOURCE_HANDLE);
+    for (uint32_t slot = 0; slot < context->dependency_capacity; ++slot)
+        if (context->dependencies[slot].active)
+            return int(STWO_CUDA_ERROR_INVALID_RESOURCE_HANDLE);
+    status = cudaStreamBeginCapture(context->lanes[lane], cudaStreamCaptureModeThreadLocal);
+    if (status == cudaSuccess) {
+        context->capture_active = true;
+        context->proof_capture = true;
+        context->capture_lane = lane;
+    }
+    return int(status);
+}
+
+// Exact keys are pointer-complete. The shape key excludes pointers but binds
+// every launch geometry, kernel and edge. On pointer changes, freshly capture
+// all current arguments and dependencies, then ask CUDA to update the entire
+// executable. Unsupported updates instantiate a fresh graph, never replay old
+// arguments. No old/new allocation is owned by this metadata cache.
+extern "C" int stwo_rv64_graph_capture_store_shape_on(
+    void *handle, uint32_t lane, const uint8_t *key, const uint8_t *shape,
+    uint64_t expected_kernels, void **out_exec, uint32_t *out_updated) {
+    if (!key || !shape || !out_exec || !out_updated || !expected_kernels)
+        return int(cudaErrorInvalidValue);
+    *out_exec = nullptr;
+    *out_updated = 0;
+    StwoNativeCudaContext *context = nullptr;
+    auto status = require_context(handle, &context);
+    if (status != cudaSuccess) return int(status);
+    if (!context->capture_active || context->capture_lane != lane)
+        return int(STWO_CUDA_ERROR_INVALID_RESOURCE_HANDLE);
+    void *raw = nullptr;
+    uint64_t kernels = 0;
+    int rc = finish_graph_capture(handle, &raw, &kernels);
+    if (rc) return rc;
+    auto graph = reinterpret_cast<cudaGraph_t>(raw);
+    if (kernels != expected_kernels || kernels > 2048) {
+        cudaGraphDestroy(graph);
+        return int(STWO_CUDA_ERROR_INVALID_CONFIGURATION);
+    }
+    auto *slot = &context->proof_graphs[0];
+    bool compatible = false;
+    for (auto &cached : context->proof_graphs) {
+        if (cached.exec && cached.lane == lane && !std::memcmp(cached.shape, shape, 32)) {
+            slot = &cached; compatible = true; break;
+        }
+    }
+    if (!compatible) for (auto &cached : context->proof_graphs) {
+        if (!cached.exec) { slot = &cached; break; }
+        if (cached.age < slot->age) slot = &cached;
+    }
+    cudaGraphExec_t exec = nullptr;
+    if (compatible) {
+        cudaGraphExecUpdateResultInfo result{};
+        const auto prior = cudaPeekAtLastError();
+        status = cudaGraphExecUpdate(slot->exec, graph, &result);
+        if (status != cudaSuccess && status != cudaErrorGraphExecUpdateFailure) {
+            cudaGraphDestroy(graph); return int(status);
+        }
+        if (status == cudaErrorGraphExecUpdateFailure && prior == cudaSuccess &&
+            cudaPeekAtLastError() == cudaErrorGraphExecUpdateFailure) (void)cudaGetLastError();
+        if (status == cudaSuccess && result.result == cudaGraphExecUpdateSuccess) {
+            exec = slot->exec;
+            *out_updated = 1;
+        }
+    }
+    if (!exec) {
+        // CUDA promises a failed update leaves the old executable unchanged.
+        // Instantiate a complete replacement before retiring that old handle.
+        status = cudaGraphInstantiate(&exec, graph, nullptr, nullptr, 0);
+        if (status != cudaSuccess) { cudaGraphDestroy(graph); return int(status); }
+        if (slot->exec) {
+            status = cudaGraphExecDestroy(slot->exec);
+            if (status != cudaSuccess) { cudaGraphExecDestroy(exec); cudaGraphDestroy(graph); return int(status); }
+        }
+    }
+    status = cudaGraphDestroy(graph);
+    // Even a graph-source retirement error must not leave the slot pointing
+    // at a destroyed old executable. Publish only the newly valid handle.
+    std::memcpy(slot->key, key, 32);
+    std::memcpy(slot->shape, shape, 32);
+    slot->exec = exec;
+    slot->lane = lane;
+    slot->age = ++context->proof_graph_clock;
+    if (status != cudaSuccess) return int(status);
+    *out_exec = reinterpret_cast<void *>(exec);
+    return 0;
+}
+
+extern "C" int stwo_rv64_graph_capture_store_on(
+    void *handle, uint32_t lane, const uint8_t *key,
+    uint64_t expected_kernels, void **out_exec) {
+    uint32_t updated = 0;
+    return stwo_rv64_graph_capture_store_shape_on(
+        handle, lane, key, key, expected_kernels, out_exec, &updated);
+}
+
+extern "C" int stwo_rv64_graph_launch_on(void *handle, uint32_t lane, void *exec) {
+    StwoNativeCudaContext *context = nullptr;
+    auto status = require_context(handle, &context);
+    if (status != cudaSuccess) return int(status);
+    if (!exec || context->capture_active || lane >= context->lane_count)
+        return int(STWO_CUDA_ERROR_INVALID_RESOURCE_HANDLE);
+    for (const auto &graph : context->proof_graphs)
+        if (graph.exec == reinterpret_cast<cudaGraphExec_t>(exec) && graph.lane == lane)
+            return int(cudaGraphLaunch(graph.exec, context->lanes[lane]));
+    return int(STWO_CUDA_ERROR_INVALID_RESOURCE_HANDLE);
+}
