+fn nativeParameters() T.Role.Component.ParametersFor(F) {
+    var p = T.symbolicParameters();
+    for (&p.local.coefficients, 0..) |*row, relation| {
+        const alpha = F.parameter(T.slots.coefficients + @as(u32, @intCast(6 * relation)));
