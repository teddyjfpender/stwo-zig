+    }
+    try C.lane.finish();active=false;try ctx.finalize(false);
+    if(trace_only)return true;
+    return ctx.isCircuitValid();
+}
+test "native GKR circuit section continues actual PCS channel with exact strict draws, roots and binding"{try std.testing.expect(try exercise(.none,false));}
+test "native GKR circuit section rejects changed chi, numerical mask and out of range salt"{
+    try std.testing.expect(!try exercise(.scope,false));try std.testing.expect(!try exercise(.mask,false));try std.testing.expect(!try exercise(.salt,false));
+}
+test "native GKR circuit section supports trace only witness provenance"{try std.testing.expect(try exercise(.none,true));}
