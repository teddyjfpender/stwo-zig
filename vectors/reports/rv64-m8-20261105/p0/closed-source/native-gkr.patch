+        try std.testing.expectEqual(@as(u32, 19), truth[0].logs[0]);
+        try std.testing.expectEqual(@as(u32, 14), truth[1].logs[0]);
+        try std.testing.expectEqual(@as(u32, 14), truth[2].logs[0]);
