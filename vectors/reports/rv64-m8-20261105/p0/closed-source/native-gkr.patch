+        pub fn digest(s: *@This(), d: Digest) void { s.h.digest(d); }
+        pub fn constantDigest(s: *@This(), d: Digest) void { s.h.digest(d); }
+        pub fn constantWord(s: *@This(), w: u32) void { s.h.word(w); }
+    }{ .h = Hasher.init(.rho) };
+    emitMainOnlyRho(main, &writer);
