--- /dev/null
+++ b/src/integrations/riscv_cpu/word16_global_execution/services/gkr_local/inter_retirement.zig
@@ -0,0 +1,163 @@
+//! Optional retirement of old device-global evaluation owners after a joined
+//! INTER commit and successful adoption of its independently owned coefficients.
+//! The native committer validates source scope/generation and returns new kind-2
+//! allocations. This extra structural check refuses aliases before any release.
+const std = @import("std");
+pub fn optionEnabled() !bool {
+    return parseOption(std.posix.getenv("STWO_RV64_NATIVE_INTER_RETIRE_GLOBALS"));
+}
+fn parseOption(text: ?[]const u8) !bool {
+    const value = text orelse return false;
+    if (std.mem.eql(u8, value, "0")) return false;
+    if (std.mem.eql(u8, value, "1")) return true;
+    return error.InvalidNativeInterRetirementOption;
+}
+pub const Stats = struct {
+    owners: usize = 0,
+    columns: usize = 0,
+    /// Published column bytes, not an arena/process peak or measured free bytes.
+    published_input_bytes: u64 = 0,
+};
+const Span = struct { first: usize, end: usize };
+fn span(words: [*]const u32, count: u64) !Span {
+    if (count == 0) return error.InvalidNativeInterRetirementRange;
+    const bytes = try std.math.mul(u64, count, 4);
+    const size = std.math.cast(usize, bytes) orelse return error.InvalidNativeInterRetirementRange;
+    const first = @intFromPtr(words);
+    if (first % @alignOf(u32) != 0) return error.InvalidNativeInterRetirementRange;
+    return .{ .first = first, .end = try std.math.add(usize, first, size) };
+}
+
+/// Takes no ownership on validation failure. On success every non-null witness
+/// is deinitialized and nulled, so the existing enclosing defer remains safe.
+/// Caller must establish the synchronous commit/adopt barrier before entering.
+pub fn afterJoinedCommit(comptime Witness: type, witnesses: []?Witness, committed: anytype) !Stats {
+    var stats: Stats = .{};
+    for (witnesses) |maybe| if (maybe) |witness| {
+        stats.owners += 1;
+        stats.columns = try std.math.add(usize, stats.columns, witness.columns.len);
+    };
+    if (stats.owners == 0) return stats;
+    if (committed.columns.len == 0) return error.InvalidNativeInterRetirementCommit;
+    const first = committed.columns[0].device orelse return error.InvalidNativeInterRetirementCommit;
+    if (first.context_token == 0 or first.generation == 0) return error.InvalidNativeInterRetirementCommit;
+    for (committed.columns) |column| {
+        const output = column.device orelse return error.InvalidNativeInterRetirementCommit;
+        if (column.coefficients.len != 0 or output.context_token != first.context_token or output.generation == 0 or column.log_size < 3 or column.log_size > 28 or output.count != @as(u64, 1) << @intCast(column.log_size)) return error.InvalidNativeInterRetirementCommit;
+        _ = try span(output.words, output.count);
+    }
+    // Validate the COMPLETE wave before releasing its first owner. One CUDA
+    // GlobalDevice.Witness owns one allocation; all its columns must share it.
+    for (witnesses) |maybe| if (maybe) |witness| {
+        if (witness.columns.len == 0) return error.InvalidNativeInterRetirementInput;
+        const first_input = witness.columns[0].device orelse return error.InvalidNativeInterRetirementInput;
+        var allocation_first: usize = std.math.maxInt(usize);
+        var allocation_end: usize = 0;
+        for (witness.columns) |column| {
+            const input = column.device orelse return error.InvalidNativeInterRetirementInput;
+            if (column.host.len != 0 or column.encoding != .evaluations or input.context_token != first.context_token or input.context_token != first_input.context_token or input.generation == 0 or input.generation != first_input.generation or column.log_size < 3 or column.log_size > 28 or input.count != @as(u64, 1) << @intCast(column.log_size)) return error.InvalidNativeInterRetirementInput;
+            const old = try span(input.words, input.count);
+            allocation_first = @min(allocation_first, old.first);
+            allocation_end = @max(allocation_end, old.end);
+            stats.published_input_bytes = try std.math.add(u64, stats.published_input_bytes, try std.math.mul(u64, input.count, 4));
+        }
+        for (committed.columns) |committed_column| {
+            const output = committed_column.device.?;
+            // A disjoint subrange of an old allocation is still unsafe:
+            // witness.deinit releases that WHOLE generation, not a slice.
+            if (output.generation == first_input.generation) return error.NativeInterRetirementAliasedCommit;
+            const next = try span(output.words, output.count);
+            if (allocation_first < next.end and next.first < allocation_end) return error.NativeInterRetirementAliasedCommit;
+        }
+    };
+    for (witnesses) |*maybe| if (maybe.*) |*witness| {
+        witness.deinit();
+        maybe.* = null;
+    };
+    return stats;
+}
+
+const TestDevice = struct { words: [*]const u32, count: u64 = 16, context_token: u64 = 1, generation: u64 };
+const TestInput = struct { log_size: u32 = 4, host: []const u32 = &.{}, encoding: enum { evaluations, coefficients } = .evaluations, device: ?TestDevice };
+const TestOutput = struct { log_size: u32 = 4, coefficients: []const u32 = &.{}, device: ?TestDevice };
+const TestTree = struct { columns: []const TestOutput };
+const TestOwner = struct {
+    words: []u32,
+    frees: usize = 0,
+    fn release(self: *TestOwner) void {
+        @memset(self.words, 0xdeadbeef);
+        self.frees += 1;
+    }
+};
+const TestWitness = struct {
+    columns: []const TestInput,
+    owner: *TestOwner,
+    fn deinit(self: *TestWitness) void {
+        self.owner.release();
+        self.* = undefined;
+    }
+};
+
+test "joined independent coefficients survive poisoning old witness storage exactly once" {
+    var input: [16]u32 = undefined;
+    for (&input, 0..) |*word, i| word.* = @intCast(17 * i + 3);
+    var coefficients = input;
+    const expected = coefficients;
+    var owner = TestOwner{ .words = &input };
+    const columns = [_]TestInput{.{ .device = .{ .words = &input, .generation = 7 } }};
+    const output = [_]TestOutput{.{ .device = .{ .words = &coefficients, .generation = 8 } }};
+    var witnesses = [_]?TestWitness{.{ .columns = &columns, .owner = &owner }};
+    const stats = try afterJoinedCommit(TestWitness, &witnesses, TestTree{ .columns = &output });
+    try std.testing.expectEqual(@as(usize, 1), stats.owners);
+    try std.testing.expectEqual(@as(u64, 64), stats.published_input_bytes);
+    try std.testing.expectEqualSlices(u32, &expected, &coefficients);
+    try std.testing.expect(std.mem.allEqual(u32, &input, 0xdeadbeef));
+    try std.testing.expect(witnesses[0] == null);
+    // Existing deferred cleanup can execute after a later RC/PCS error.
+    for (&witnesses) |*maybe| if (maybe.*) |*witness| witness.deinit();
+    try std.testing.expectEqual(@as(usize, 1), owner.frees);
+}
+
+test "borrowed generation and overlapping replacement are refused before release" {
+    var input: [32]u32 = @splat(1);
+    var other: [16]u32 = @splat(2);
+    var owner = TestOwner{ .words = input[0..16] };
+    const columns = [_]TestInput{.{ .device = .{ .words = &input, .generation = 7 } }};
+    var output = [_]TestOutput{.{ .device = .{ .words = &other, .generation = 7 } }};
+    var witnesses = [_]?TestWitness{.{ .columns = &columns, .owner = &owner }};
+    try std.testing.expectError(error.NativeInterRetirementAliasedCommit, afterJoinedCommit(TestWitness, &witnesses, TestTree{ .columns = &output }));
+    output[0].device = .{ .words = input[8..].ptr, .generation = 8 };
+    try std.testing.expectError(error.NativeInterRetirementAliasedCommit, afterJoinedCommit(TestWitness, &witnesses, TestTree{ .columns = &output }));
+    try std.testing.expectEqual(@as(usize, 0), owner.frees);
+    try std.testing.expect(witnesses[0] != null);
+}
+
+test "foreign context, stale geometry and mixed-owner inputs fail atomically" {
+    var a: [16]u32 = @splat(1);
+    var b: [16]u32 = @splat(2);
+    var c: [16]u32 = @splat(3);
+    var owners = [_]TestOwner{ .{ .words = &a }, .{ .words = &b } };
+    var columns = [_]TestInput{ .{ .device = .{ .words = &a, .generation = 7 } }, .{ .device = .{ .words = &b, .generation = 8, .context_token = 2 } } };
+    var witnesses = [_]?TestWitness{ .{ .columns = columns[0..1], .owner = &owners[0] }, .{ .columns = columns[1..2], .owner = &owners[1] } };
+    const output = [_]TestOutput{.{ .device = .{ .words = &c, .generation = 9 } }};
+    try std.testing.expectError(error.InvalidNativeInterRetirementInput, afterJoinedCommit(TestWitness, &witnesses, TestTree{ .columns = &output }));
+    try std.testing.expectEqual(@as(usize, 0), owners[0].frees);
+    columns[1].device.?.context_token = 1;
+    columns[1].device.?.count = 15;
+    try std.testing.expectError(error.InvalidNativeInterRetirementInput, afterJoinedCommit(TestWitness, &witnesses, TestTree{ .columns = &output }));
+    columns[1].device.?.count = 16;
+    witnesses[0].?.columns = &columns;
+    try std.testing.expectError(error.InvalidNativeInterRetirementInput, afterJoinedCommit(TestWitness, &witnesses, TestTree{ .columns = &output }));
+    try std.testing.expectEqual(@as(usize, 0), owners[0].frees);
+    try std.testing.expectEqual(@as(usize, 0), owners[1].frees);
+}
+
+test "retirement flag is strict and empty waves need no commit owner" {
+    try std.testing.expect(!try parseOption(null));
+    try std.testing.expect(!try parseOption("0"));
+    try std.testing.expect(try parseOption("1"));
+    try std.testing.expectError(error.InvalidNativeInterRetirementOption, parseOption("check"));
+    var witnesses = [_]?TestWitness{null};
+    const stats = try afterJoinedCommit(TestWitness, &witnesses, TestTree{ .columns = &.{} });
+    try std.testing.expectEqual(@as(usize, 0), stats.owners);
+}
