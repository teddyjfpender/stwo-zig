+pub fn expectedWords(a: std.mem.Allocator, setup: *const R.CpuSetup, request: P.Request, first: [T.FAMILIES]u32, expected: M.ExpectedWorker, manifest: [32]u8, main_root: [32]u8, receipt: [32]u8, claims: []const C.O) ![]u32 {
