+    const dword = try T.dwordCounts(setup.bridges, request.ls_dword);
+    for (plan.slots) |slot| {
+        var rows: u32 = 0;
+        var calls: u32 = 0;
+        var first_id: u32 = 1;
+        switch (slot.origin) {
+            .core => |role| rows = switch (role) {
+                .initial => @intCast(request.base.memory.initial.len),
+                .terminal => @intCast(request.base.memory.terminal.len),
+                .ls => ls.head,
+                .ls_tail => ls.tail,
