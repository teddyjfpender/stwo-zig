+pub fn appendKeccakEarlyLate(a: std.mem.Allocator, out: *std.ArrayList(W.TruthDeclaration), total: u32, options: KeccakTruthOptions) !void {
+    if (!options.v3) return error.KeccakEarlyLateRequiresV3;
