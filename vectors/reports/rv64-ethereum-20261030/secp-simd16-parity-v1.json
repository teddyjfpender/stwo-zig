{
  "schema": "rv64-secp-simd16-parity-v1",
  "scope": "Secp product, linear and both-format RAM bridge domain evaluation only; no full-block performance/proof claim.",
  "arithmetic": "16 logical row lanes assembled from unchanged core native packs; local field equations remain PackedM31; polynomial/BYTE/wire/RAM/call challenge terms and prefixes remain PackedQM31. Scalar arbitrary-Q wrappers retain the same equations and order of emissions.",
  "shared_structural_trait": "Only optional SecureField/toSecure/fromBaseScalar hooks in shared secp256k1_mul_direct; no RV64 import, no new machine/type factory, scalarM31/Q/legacyDSL paths unchanged.",
  "memory": "One bounded heap Scratch per admitted worker and coset; no per-row allocations or scalar-Q copies; predecessor gather and output positions remain exact for partial worker tails. Existing barrier drains before coset reuse.",
  "gates": {
    "fields_and_secp_lanes_release_safe": true,
    "fields_and_secp_lanes_release_fast": true,
    "independent_signed_i128_secure_product_oracle_and_p_minus_1_edges": true,
    "secp_native_release_safe_29_tests": true,
    "historical_five_complete_proof_sha_exact": true,
    "historical_gate_mode": "ReleaseSafe,3workers",
    "fresh_old_receiver_total_cases": 148,
    "valid_acceptances": 5,
    "expected_rejections": 143,
    "scalar_arbitrary_q_secp_degree_mutation_tests": "Existing29-test Secp suite passed, including dense arbitrary-Q and degree tests."
  },
  "gate_commands": [
    "zig build test-riscv64-simd-fields -Doptimize=ReleaseSafe",
