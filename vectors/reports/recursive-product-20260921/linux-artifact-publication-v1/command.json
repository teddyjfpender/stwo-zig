[
  "qemu-system-x86_64",
  "-machine",
  "q35,accel=tcg",
  "-cpu",
  "max",
  "-smp",
  "2",
  "-m",
  "1024",
  "-kernel",
  "/tmp/pr198-linux-publication-v1/vmlinuz-virt",
  "-initrd",
  "/tmp/pr198-linux-publication-v1/guest-initramfs.gz",
  "-append",
