@@ -44,3 +44,54 @@ fn product_full(a: &Fq2, b: &Fq2) -> Fq2 {
 fn product_full(a: &Fq2, b: &Fq2) -> Fq2 {
     Fq2::new(a.c0 * b.c0 - a.c1 * b.c1, a.c0 * b.c1 + a.c1 * b.c0)
 }
+
+/// Write the admitted result directly into the receiver, avoiding a large
+/// Option<Fq2> return temporary and its caller copy. Scalar shortcuts retain
+/// the original formulas; all packet inputs are captured before output writes.
+#[cfg(feature = "stwo-inplace-service")]
+#[inline(always)]
+pub(super) fn product_assign(a: &mut Fq2, b: &Fq2) {
+    if (a.c1.0 .0[0] | a.c1.0 .0[1] | a.c1.0 .0[2] | a.c1.0 .0[3]) == 0
+        || (b.c1.0 .0[0] | b.c1.0 .0[1] | b.c1.0 .0[2] | b.c1.0 .0[3]) == 0
+    {
+        *a = product(a, b);
+        return;
+    }
+    product_full_assign(a, b);
+}
+#[cfg(all(feature = "stwo-inplace-service", target_arch = "riscv64"))]
+#[allow(unsafe_code)]
+#[inline(always)]
+fn product_full_assign(a: &mut Fq2, b: &Fq2) {
+    #[repr(C, align(32))]
+    struct Packet([u64; 16]);
+    let mut packet = Packet([
+        a.c0.0 .0[0],
+        a.c0.0 .0[1],
+        a.c0.0 .0[2],
+        a.c0.0 .0[3],
+        a.c1.0 .0[0],
+        a.c1.0 .0[1],
+        a.c1.0 .0[2],
+        a.c1.0 .0[3],
+        b.c0.0 .0[0],
+        b.c0.0 .0[1],
+        b.c0.0 .0[2],
+        b.c0.0 .0[3],
+        b.c1.0 .0[0],
+        b.c1.0 .0[1],
+        b.c1.0 .0[2],
+        b.c1.0 .0[3],
+    ]);
+    // SAFETY: initialized 128-byte packet, aligned to 32; the admitted
+    // canonical Fp2 relation overwrites exactly its first 64 bytes.
+    unsafe {
+        core::arch::asm!("ecall", in("a0") packet.0.as_mut_ptr(), in("a7") 0x0003_0102usize, options(nostack));
+    }
+    a.c0.0 .0 = [packet.0[0], packet.0[1], packet.0[2], packet.0[3]];
+    a.c1.0 .0 = [packet.0[4], packet.0[5], packet.0[6], packet.0[7]];
+}
+#[cfg(all(feature = "stwo-inplace-service", not(target_arch = "riscv64")))]
+fn product_full_assign(a: &mut Fq2, b: &Fq2) {
+    *a = product_full(a, b);
+}
