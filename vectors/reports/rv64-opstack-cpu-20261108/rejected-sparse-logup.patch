diff --git a/src/prover/air/logup_sparse_test.zig b/src/prover/air/logup_sparse_test.zig
new file mode 100644
--- /dev/null
+++ b/src/prover/air/logup_sparse_test.zig
@@ -0,0 +1,102 @@
+const std = @import("std");
+const core = @import("stwo_core");
+const M = core.fields.m31.M31;
+const Builder = @import("logup_columns_family.zig").ForField;
+const Col = @import("../pcs/mod.zig").ColumnEvaluation;
+const work = @import("../work_pool.zig");
+
+fn qualify(comptime F: type) !void {
+    const a = std.testing.allocator;
+    const B = Builder(F);
+    const degree = F.one().toM31Array().len;
+    const log = 13;
+    const n = 1 << log;
+    const width = 3;
+    const Context = struct {
+        mode: usize,
+        bad: bool = false,
+        denominators: [8]F,
+        fn fill(self: @This(), row: usize, fractions: []B.Fraction) !void {
+            for (fractions, 0..) |*fraction, c| {
+                const nonzero = switch (self.mode) {
+                    0 => false,
+                    1 => (row + c) % 2 == 0,
+                    2 => (row * width + c) % 33 == 0,
+                    else => true,
+                };
+                fraction.* = .{
+                    .numerator = if (nonzero) F.fromBase(M.fromU64(row + c + 1)) else F.zero(),
+                    .denominator = if (self.bad and row == 64) F.zero() else self.denominators[(3 * row + c) % 8],
+                };
+            }
+        }
+    };
+    var denominators: [8]F = undefined;
+    var inverses: [8]F = undefined;
+    for (&denominators, &inverses, 0..) |*d, *inverse, i| {
+        var coordinates: [degree]M = undefined;
+        for (&coordinates, 0..) |*v, c| v.* = M.fromU64(17 + 131 * i + c);
+        d.* = F.fromM31Array(coordinates);
+        inverse.* = try d.inv();
+    }
+    var pool: work.WorkPool = undefined;
+    try pool.initInPlaceWithOptions(.{ .worker_count = 3 });
+    defer pool.deinit();
+    var binding = try work.ScopedPoolBinding.init(&pool);
+    defer binding.deinit();
+    for (0..4) |mode| {
+        const ctx = Context{ .mode = mode, .denominators = denominators };
+        const out = try B.build(a, log, width, ctx, Context.fill);
+        defer {
+            for (out.columns) |column| a.free(column.values);
+            a.free(out.columns);
+        }
+        const expected = try a.alloc(F, width * n);
+        defer a.free(expected);
+        var claim = F.zero();
+        var active: usize = 0;
+        for (0..n) |row| {
+            var fractions: [width]B.Fraction = undefined;
+            try ctx.fill(row, &fractions);
+            var sum = F.zero();
+            for (fractions, 0..) |fraction, c| {
+                // Independent scalar oracle inverts all eight denominator
+                // values, including those used only by zero-weight fractions.
+                sum = sum.add(fraction.numerator.mul(inverses[(3 * row + c) % 8]));
+                expected[c * n + row] = sum;
+                if (!fraction.numerator.isZero()) active += 1;
+            }
+            claim = claim.add(sum);
+        }
+        try std.testing.expect(claim.eql(out.claimed_sum));
+        try std.testing.expectEqual(n * width, out.work.fractions);
+        try std.testing.expectEqual(active, out.work.nonzero);
+        try std.testing.expect(out.work.inverted >= active and out.work.inverted <= n * width);
+        if (mode == 0) try std.testing.expectEqual(@as(usize, 0), out.work.inverted);
+        const shift = claim.mulM31(try M.fromU64(n).inv());
+        const last = expected[(width - 1) * n ..];
+        for (last) |*value| value.* = value.sub(shift);
+        core.utils.bitReverse(F, last);
+        const coset = try core.utils.circleDomainOrderToCosetOrder(F, a, last);
+        defer a.free(coset);
+        var sum = F.zero();
+        for (coset) |*value| {
+            sum = sum.add(value.*);
+            value.* = sum;
+        }
+        const circle = try core.utils.cosetOrderToCircleDomainOrder(F, a, coset);
+        defer a.free(circle);
+        core.utils.bitReverse(F, circle);
+        @memcpy(last, circle);
+        for (0..width) |c| for (expected[c * n ..][0..n], 0..) |value, row|
+            for (value.toM31Array(), 0..) |coordinate, j|
+                try std.testing.expectEqual(coordinate, out.columns[c * degree + j].values[row]);
+    }
+    // A zero numerator must never hide a forbidden denominator.
+    try std.testing.expectError(error.DegenerateDenominator, B.build(a, log, width, Context{ .mode = 0, .bad = true, .denominators = denominators }, Context.fill));
+}
+
+test "sparse LogUp inversion preserves every QM31 and OM31 trace coordinate" {
+    try qualify(core.fields.qm31.QM31);
+    try qualify(core.fields.om31.OM31);
+}
