  "provisioning": {
    "status": "pending",
    "note": "What stands between this corpus and committed, scored RISC-V workloads. Nothing below is estimated: each item is work that has not been done, listed so the basket's incompleteness is loud rather than silent (the workload_registry.groups.cairo_cpu.workload_provisioning pattern).",
    "blockers": [
      {
        "id": "guest_abi_port",
        "applies_to": [
          "fib",
          "mat-mul",
          "ec",
          "sha2",
          "sha2-chain",
          "sha3",
          "sha3-chain",
          "blake",
          "blake-chain"
        ],
        "reason": "guest entry and I/O use the SP1 zkVM ABI (sp1_zkvm::entrypoint!, sp1_zkvm::io::read/commit); the rv32im-zkvm-v1 profile this repository proves is bare-metal with a linker-defined input region, __halt_flag termination, and OUTPUT_LEN/OUTPUT_DATA public framing (see vectors/riscv_guests/*/linker.ld). Porting rewrites the entry and I/O shim; the computational body is unchanged."
      },
      {
        "id": "precompile_out_of_profile",
        "applies_to": [
          "ec-precompile",
          "sha2-precompile",
          "sha2-chain-precompile",
          "sha3-precompile",
          "sha3-chain-precompile"
        ],
        "reason": "the guest additionally dispatches SP1 syscall precompiles, which rv32im-zkvm-v1 does not implement and does not intend to; this program is out of profile rather than merely unprovisioned."
      },
      {
        "id": "deterministic_toolchain_pin",
        "applies_to": [
          "fib",
          "mat-mul",
          "ec",
          "ec-precompile",
          "sha2",
          "sha2-precompile",
          "sha2-chain",
          "sha2-chain-precompile",
          "sha3",
          "sha3-precompile",
          "sha3-chain",
          "sha3-chain-precompile",
          "blake",
          "blake-chain"
        ],
        "reason": "a committed ELF needs an exact pinned rustc (the upstream file pins a floating `stable` channel). Compiled RISC-V guests in this repository are vendored with their exact toolchain string because they are not byte-reproducible across compiler versions \u2014 see vectors/riscv_elfs/crypto/provenance.json."
      },
      {
        "id": "sail_differential_admission",
        "applies_to": [
          "fib",
          "mat-mul",
          "ec",
          "ec-precompile",
          "sha2",
          "sha2-precompile",
          "sha2-chain",
          "sha2-chain-precompile",
          "sha3",
          "sha3-precompile",
          "sha3-chain",
          "sha3-chain-precompile",
          "blake",
          "blake-chain"
        ],
        "reason": "adding any program to the release corpus (vectors/riscv_elfs/trace_vectors.json) invalidates the committed Sail/Spike attestation at conformance/riscv/formal-corpus-evidence.json: that file binds the program count and a comparison_digest over the exact per-program trace digests, and scripts/riscv_sail_gate.py bind fails closed on any change without regenerated LIVE evidence. Regeneration needs the pinned Sail emulator (scripts/riscv_formal_tools.py); a corpus addition without it is not admissible."
      }
    ],
    "regeneration_commands": [
      "python3 scripts/riscv_formal_tools.py --workspace /tmp/stwo-riscv-formal",
      "python3 scripts/riscv_trace_vectors.py --update",
      "python3 scripts/riscv_trace_vectors.py --sail-bin <sail_riscv_sim> --spike-bin <spike>",
      "python3 scripts/riscv_sail_gate.py run --workspace /tmp/stwo-riscv-formal"
    ]
  }
}
