+/// Injective encoding within the packed namespace. Hash-table equality compares
+/// all bytes; no digest or probabilistic fingerprint replaces tuple equality.
+fn packedKey(values: []const QM31) ?[32]u8 {
+    if (values.len > 7) return null;
+    var key: [32]u8 = @splat(0);
+    std.mem.writeInt(u32, key[0..4], @intCast(values.len), .little);
+    for (values, 0..) |value, index| {
+        const base = value.tryIntoM31() catch return null;
+        std.mem.writeInt(u32, key[4 + index * 4 ..][0..4], base.toU32(), .little);
+    }
+    return key;
+}
