+        _ = self;
+        if (verifier_id != 1 and verifier_id != 2) return error.InvalidWitness;
+        try preprocessing.validateAgainst(reference);
+        try validateEvaluationsHot(reference, evaluations, kind);
+        var count: usize = 0;
+        for (preprocessing.rows) |row| count += @intFromBool(row.verifier_id == verifier_id);
+        const result = try allocator.alloc([component.LOGICAL_INPUT_COUNT]M31, count);
