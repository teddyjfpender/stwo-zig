+    /// Admit the complete schedule and witness once, then materialize only the
+    /// requested lane directly in logical-row order. Internally allocated output
+    /// cannot alias the borrowed authority or witness.
+    pub fn generateLogicalForLane(
+        self: *const Executor,
+        allocator: std.mem.Allocator,
+        preprocessing: *const Preprocessed,
+        reference: Reference,
+        input_witness: InputWitness,
+        proof_kind: ProofKind,
+        verifier_id: u32,
+    ) Error![][component.LOGICAL_INPUT_COUNT]M31 {
+        _ = self;
+        if (verifier_id != 1 and verifier_id != 2) return error.InvalidWitness;
+        try preprocessing.validateAgainst(reference);
+        try validateWitness(reference, input_witness, proof_kind);
+        var count: usize = 0;
+        for (preprocessing.rows) |row| count += @intFromBool(row.verifier_id == verifier_id);
+        const result = try allocator.alloc([component.LOGICAL_INPUT_COUNT]M31, count);
+        var cursor: usize = 0;
+        for (preprocessing.rows) |row| {
+            if (row.verifier_id != verifier_id) continue;
+            result[cursor] = logicalInputs(.{ M31.one(), input_witness.lanes[row.lane].input_values[row.binding] }, row.values(), proof_kind);
+            cursor += 1;
+        }
+        return result;
+    }
+
     pub fn generateMainInto(
         self: *const Executor,
         preprocessing: *const Preprocessed,
