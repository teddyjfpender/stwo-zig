@@ -175,6 +175,35 @@ pub const Executor = struct {
         return preprocessing.generatePreprocessedInto(reference, columns, self);
     }
 
+    /// Bulk admission is identical to the column writer; output is owned and
+    /// only the selected lane is materialized. No per-row authority rescans.
+    pub fn generateLogicalForLane(
+        self: *const Executor,
+        allocator: std.mem.Allocator,
+        preprocessing: *const Preprocessed,
+        reference: Reference,
+        evaluations: Evaluations,
+        kind: ProofKind,
+        verifier_id: u32,
+    ) Error![][component.LOGICAL_INPUT_COUNT]M31 {
+        _ = self;
+        if (verifier_id != 1 and verifier_id != 2) return error.InvalidWitness;
+        try preprocessing.validateAgainst(reference);
+        try validateEvaluationsHot(reference, evaluations, kind);
+        var count: usize = 0;
+        for (preprocessing.rows) |row| count += @intFromBool(row.verifier_id == verifier_id);
+        const result = try allocator.alloc([component.LOGICAL_INPUT_COUNT]M31, count);
+        errdefer allocator.free(result);
+        var cursor: usize = 0;
+        for (preprocessing.rows) |row| {
+            if (row.verifier_id != verifier_id) continue;
+            const value = evaluations.at(row.lane).values[row.node_id].tryIntoM31() catch return error.InputIsNotBaseField;
+            result[cursor] = logicalInputs(.{ M31.one(), value }, row.values(), kind);
+            cursor += 1;
+        }
+        return result;
+    }
+
     pub fn generateMainInto(
         self: *const Executor,
         preprocessing: *const Preprocessed,
