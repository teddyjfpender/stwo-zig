+    const metal = @import("stwo_metal_backend");
+    const air = @import("recursion/air/mod.zig");
+    const Airs = @import("prover/blake3_commitment_components.zig").Airs;
+    var lease = try metal.shared_runtime.acquireExisting();
+    defer lease.deinit();
