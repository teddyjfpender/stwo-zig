+        const name = try metal.riscv_polynomial_codegen.framework.kernelName(a, .{ .program = &program, .tree_column_counts = &counts });
+        defer a.free(name);
+        var found = false;
+        for (profile.exports()) |entry| found = found or std.mem.eql(u8, name, entry.name);
+        try std.testing.expect(found);
+    }
