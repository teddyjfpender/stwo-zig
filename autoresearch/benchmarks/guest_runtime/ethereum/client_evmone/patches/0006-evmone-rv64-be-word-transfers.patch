+/// stwo RV64IM: the 32 big-endian bytes at `p` as four little-endian limbs written to `out`
+/// (out[0] least significant). All four source words are read before `out` is written.
+/// Aligned: four loads and a mask swap. Unaligned: the five aligned words that hold the
+/// bytes, funnel-shifted (every word read holds at least one of the 32 bytes).
+[[gnu::always_inline]] inline void stwo_load_be256(uint64_t* out, const uint8_t* p) noexcept
+{
+    const auto m = intx::be_bytes::g_swap_masks;
+    const auto addr = reinterpret_cast<uintptr_t>(p);
+    const auto sh = (addr & 7) * 8;
+    const auto* a = static_cast<const uint8_t*>(__builtin_assume_aligned(
+        reinterpret_cast<const uint8_t*>(addr & ~uintptr_t{7}), 8));
+    uint64_t w[5];
+    std::memcpy(&w[0], a, 8);
+    std::memcpy(&w[1], a + 8, 8);
+    std::memcpy(&w[2], a + 16, 8);
+    std::memcpy(&w[3], a + 24, 8);
+    if (sh != 0)
+    {
+        std::memcpy(&w[4], a + 32, 8);
+        for (size_t i = 0; i < 4; ++i)
+            w[i] = (w[i] >> sh) | (w[i + 1] << (64 - sh));
+    }
+    const auto r0 = intx::be_bytes::bswap64(w[3], m);
+    const auto r1 = intx::be_bytes::bswap64(w[2], m);
+    const auto r2 = intx::be_bytes::bswap64(w[1], m);
+    const auto r3 = intx::be_bytes::bswap64(w[0], m);
+    out[0] = r0;
+    out[1] = r1;
+    out[2] = r2;
+    out[3] = r3;
+}
+#endif
