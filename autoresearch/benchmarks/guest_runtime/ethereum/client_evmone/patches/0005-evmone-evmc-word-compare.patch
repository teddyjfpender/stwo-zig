+#if defined(ZEG_STWO)
+namespace stwo_detail
+{
+// stwo RV64IM guest: misaligned loads trap and evmc byte arrays have
+// alignment 1, so load64le() above compiles to eight byte loads. Words of
+// any alignment are a funnel of the aligned words holding their bytes.
+typedef uint64_t __attribute__((may_alias)) u64a;
+inline uint64_t ldu64(const uint8_t* p) noexcept
+{
+    const unsigned off = reinterpret_cast<uintptr_t>(p) & 7;
+    const u64a* a = reinterpret_cast<const u64a*>(p - off);
+    if (off == 0)
+        return a[0];
+    return (a[0] >> (off * 8)) | (a[1] << (64 - off * 8));
+}
+/// Low `k` (1..8) bytes at p as a little-endian word.
+inline uint64_t ldu_tail(const uint8_t* p, unsigned k) noexcept
+{
+    const unsigned off = reinterpret_cast<uintptr_t>(p) & 7;
+    const u64a* a = reinterpret_cast<const u64a*>(p - off);
+    uint64_t w = a[0] >> (off * 8);
+    if (off + k > 8)
+        w |= a[1] << (64 - off * 8);
+    return k == 8 ? w : w & ((uint64_t{1} << (8 * k)) - 1);
+}
+}  // namespace stwo_detail
+#endif
