+#if defined(ZEG_STWO)
+// stwo RV64IM: evmc byte arrays have alignment 1, so fixed-size copies and
+// compares become libc calls with byte-alignment handling. When both operands
+// happen to be 8-byte aligned (table records and hash-map nodes are), use word
+// accesses instead; otherwise assemble words with funnel shifts (aligned
+// destination for copies). zisk_xmemcmp is only ever tested against 0 by its
+// callers, so these paths return 0 (equal) or 1 (different).
+namespace detail {
+typedef uint64_t __attribute__((may_alias)) u64a;
+typedef uint32_t __attribute__((may_alias)) u32a;
+inline bool aligned8(const void* a, const void* b) {
+    return ((reinterpret_cast<uintptr_t>(a) | reinterpret_cast<uintptr_t>(b)) & 7) == 0;
+}
+// Little-endian word of the k (1..8) bytes at p, any alignment, upper bytes
+// zero. Funnel of the aligned words holding them (RV64IM traps on misaligned
+// loads; this avoids the byte loop or libc call LLVM emits otherwise).
+inline uint64_t ldu(const void* p, size_t k) {
+    const unsigned off = reinterpret_cast<uintptr_t>(p) & 7;
+    const auto* a = reinterpret_cast<const u64a*>(static_cast<const uint8_t*>(p) - off);
+    uint64_t w = a[0] >> (off * 8);
+    if (off + k > 8) w |= a[1] << (64 - off * 8);
+    return k == 8 ? w : w & ((uint64_t(1) << (8 * k)) - 1);
+}
+}  // namespace detail
+#endif
+
 inline void zisk_memcpy(void* dst, const void* src, size_t size) { std::memcpy(dst, src, size); }
 template <size_t Size>
-inline void zisk_xmemcpy(void* dst, const void* src) { std::memcpy(dst, src, Size); }
+inline void zisk_xmemcpy(void* dst, const void* src) {
+#if defined(ZEG_STWO)
+    if constexpr (Size % 8 == 0 && Size <= 64) {
+        if (detail::aligned8(dst, src)) {
+            auto* d = static_cast<detail::u64a*>(dst);
+            const auto* s = static_cast<const detail::u64a*>(src);
+            for (size_t i = 0; i < Size / 8; ++i) d[i] = s[i];
+            return;
+        }
+        if (detail::aligned8(dst, dst)) {
+            auto* d = static_cast<detail::u64a*>(dst);
+            const auto* s = static_cast<const uint8_t*>(src);
+            for (size_t i = 0; i < Size / 8; ++i) d[i] = detail::ldu(s + 8 * i, 8);
+            return;
+        }
+    } else if constexpr (Size == 20) {
+        if (detail::aligned8(dst, src)) {
+            auto* d = static_cast<detail::u64a*>(dst);
+            const auto* s = static_cast<const detail::u64a*>(src);
+            d[0] = s[0];
+            d[1] = s[1];
+            *reinterpret_cast<detail::u32a*>(d + 2) = *reinterpret_cast<const detail::u32a*>(s + 2);
+            return;
+        }
+        if (detail::aligned8(dst, dst)) {
+            auto* d = static_cast<detail::u64a*>(dst);
+            const auto* s = static_cast<const uint8_t*>(src);
+            d[0] = detail::ldu(s, 8);
+            d[1] = detail::ldu(s + 8, 8);
+            *reinterpret_cast<detail::u32a*>(d + 2) = static_cast<uint32_t>(detail::ldu(s + 16, 4));
+            return;
+        }
+    }
+#endif
+    std::memcpy(dst, src, Size);
+}
 
