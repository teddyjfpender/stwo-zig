--- /dev/null
+++ b/cpp-guest/include/zeg/stwo_hooks.hpp
@@ -0,0 +1,31 @@
+// Hooks for the stwo RV64 port (patch-added; implemented in client_evmone/glue).
+// The stwo guest reads the canonical SSZ StatelessInput, whose witness is a set
+// of trie nodes without key preimages, so the Accounts/Storages tables are
+// filled lazily: a lookup miss walks the witness trie from the authenticated
+// parent state root and appends the row (present or proven-absent value).
+#pragma once
+#include <evmc/evmc.hpp>
+
+namespace zeg {
+class Accounts;
+class Storages;
+class ConsensusInfo;
+class Transactions;
+class PreviousBlocks;
+
+// Append a row for `addr` if its trie path is in the witness; false if the
+// path leaves the witness (the key is then unproven and only warmable).
+bool stwo_lazy_load_account(Accounts& accounts, const evmc::address& addr) noexcept;
+bool stwo_lazy_load_storage(Storages& storages, const evmc::address& addr,
+                            const evmc::bytes32& position) noexcept;
+// Called by run() in place of the ZEG0 StateRoot section.
+void stwo_state_begin(Accounts& accounts, Storages& storages, const ConsensusInfo& consensus,
+                      const PreviousBlocks& previous_blocks);
+evmc::bytes32 stwo_state_new_root(Accounts& accounts, Storages& storages);
+void stwo_after_block(const Transactions& transactions, const evmc::bytes32& block_hash);
+// Sender of transaction `index` from the input's public-key hint; false if no
+// usable hint (the caller recovers instead). Signatures are verified in batch
+// before any output is produced.
+bool stwo_tx_sender(uint64_t index, const evmc::bytes32& hash, const evmc::uint256be& r,
+                    const evmc::uint256be& s, unsigned recid, evmc::address& out) noexcept;
+}  // namespace zeg
