 template <size_t Size>
-inline int64_t zisk_xmemcmp(const void* a, const void* b) { return std::memcmp(a, b, Size); }
+inline int64_t zisk_xmemcmp(const void* a, const void* b) {
+#if defined(ZEG_STWO)
+    if constexpr (Size % 8 == 0 && Size <= 64) {
+        if (detail::aligned8(a, b)) {
+            const auto* x = static_cast<const detail::u64a*>(a);
+            const auto* y = static_cast<const detail::u64a*>(b);
+            uint64_t d = 0;
+            for (size_t i = 0; i < Size / 8; ++i) d |= x[i] ^ y[i];
+            return d != 0;
+        }
+        const auto* x = static_cast<const uint8_t*>(a);
+        const auto* y = static_cast<const uint8_t*>(b);
+        uint64_t d = 0;
+        for (size_t i = 0; i < Size / 8; ++i) d |= detail::ldu(x + 8 * i, 8) ^ detail::ldu(y + 8 * i, 8);
+        return d != 0;
+    } else if constexpr (Size == 20) {
+        if (detail::aligned8(a, b)) {
+            const auto* x = static_cast<const detail::u64a*>(a);
+            const auto* y = static_cast<const detail::u64a*>(b);
+            const uint64_t d = (x[0] ^ y[0]) | (x[1] ^ y[1]) |
+                (*reinterpret_cast<const detail::u32a*>(x + 2) ^ *reinterpret_cast<const detail::u32a*>(y + 2));
+            return d != 0;
+        }
+        const auto* x = static_cast<const uint8_t*>(a);
+        const auto* y = static_cast<const uint8_t*>(b);
+        const uint64_t d = (detail::ldu(x, 8) ^ detail::ldu(y, 8)) | (detail::ldu(x + 8, 8) ^ detail::ldu(y + 8, 8)) |
+            (detail::ldu(x + 16, 4) ^ detail::ldu(y + 16, 4));
+        return d != 0;
