+static void mul_mont_n(limb_t ret[], const limb_t a[], const limb_t b[],
+                       const limb_t p[], limb_t n0, size_t n)
+{
+#if defined(CANDIDATE_BLS)
+    /* 384-bit operands (6 64-bit or 12 32-bit limbs: same little-endian bytes). */
+    if (n * sizeof(limb_t) == 48) {
+        stwo_arith384_mont(ret, a, b, p);
+        return;
+    }
+#endif
+    __builtin_assume(n != 0 && n%2 == 0);
+#if LIMB_T_BITS==64
+    if (n == 6) { mul_mont_body(ret, a, b, p, n0, 6); return; }
+    if (n == 4) { mul_mont_body(ret, a, b, p, n0, 4); return; }
+#endif
+    mul_mont_body(ret, a, b, p, n0, n);
+}
