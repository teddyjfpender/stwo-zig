+// baseline_xlat.inl -- stwo: lazily translated segments for the baseline interpreter.
+//
+// Included in baseline_execution.cpp's anonymous namespace, after dispatch_cgoto.
+//
+// The cgoto interpreter pays, on every opcode, a byte dispatch (6 RV64 instructions), a gas
+// check (2), stack-bound checks (1-2) and decodes PUSH data from the code bytes. Here a
+// *segment* (straight-line code from a JUMPDEST, from pc 0, after a JUMPI or after a
+// split, up to the next JUMP/JUMPI/terminator/JUMPDEST) is translated the first time it is
+// entered into a stream of 8-byte records: the address of the handler, then immediates.
+// The segment header carries the segment's total base gas, how many stack items it needs
+// and how far it grows the stack; one check of those at entry replaces the per-opcode
+// checks, and each handler ends in `ip += n; goto *ip[0]` (3 instructions).
+//
+// Exactness. The checked interpreter (dispatch_cgoto) stays the reference and the escape
+// hatch: whenever the translated path cannot prove it does exactly what the per-opcode
+// checks would do, it hands the frame over to dispatch_cgoto at the exact pc, stack and
+// gas the reference would have there, and that frame finishes in dispatch_cgoto.
+//  - Entry: if gas < segment base gas, or the stack is too short or too full for the
+//    segment, nothing of the segment has run; hand over at its first pc with the gas
+//    restored. (Every opcode of a segment runs unless one halts it, so the reference
+//    would then halt inside the segment anyway; handing over keeps the halting opcode,
+//    status and everything before it identical.)
+//  - Opcodes whose implementation reads or charges gas (Result/TermResult signatures:
+//    memory growth, SLOAD/SSTORE, GAS, CALL*, CREATE*, LOG*, KECCAK256, EXP, ...) get the
+//    gas the reference would pass them: the base gas of the opcodes after them in the
+//    segment (precharged at entry) is added back for the call and taken off again after.
+//    If what is left after the call cannot cover those later opcodes, hand over at the
+//    next pc with the exact gas.
+//  - Undefined opcodes (per revision), DUPN/SWAPN/EXCHANGE and anything else not handled
+//    here end the segment with a hand-over record at their pc.
+//  - Jump targets: dynamic JUMP/JUMPI targets are validated with the JUMPDEST bitset as
+//    before; static ones (PUSH1/PUSH2 immediately before JUMP/JUMPI) are validated once
+//    and the result (target segment or a bad-jump record) is patched into the record.
+// The fused PUSH2 JUMP / <test> PUSH2 JUMPI / PUSH4 EQ PUSH2 JUMPI sequences of
+// fused_dispatch.inl are chosen here at translation time instead of being re-detected at
+// every execution; their gas and stack effect are part of the segment like any opcode's.
+
+constexpr int kXMaxOps = 96;     ///< Opcodes per segment (longer runs are split).
+constexpr int kXGrowCap = 32;    ///< Max stack growth within a segment (entry fast check).
+constexpr size_t kXBudget = size_t{48} << 20;  ///< Arena + table bytes before giving up.
+constexpr size_t kXChunkWords = (size_t{1} << 17) - 8;  ///< ~1 MiB arena chunks.
+
+using XWord = uint64_t;
+
+enum XKind : uint8_t
+{
+    XK_NONE,
+    XK_PLAIN,    ///< void(StackTop)
+    XK_PLAIN_S,  ///< void(StackTop, ExecutionState&)
+    XK_GAS,      ///< Result(StackTop, int64_t, ExecutionState&)
+    XK_TERM,     ///< TermResult(StackTop, int64_t, ExecutionState&)
+    XK_CODEIT,   ///< code_iterator(StackTop, ExecutionState&, code_iterator)
+};
+
+constexpr XKind xkind_of(void (*)(StackTop) noexcept) noexcept
+{
+    return XK_PLAIN;
+}
+constexpr XKind xkind_of(void (*)(StackTop, ExecutionState&) noexcept) noexcept
+{
+    return XK_PLAIN_S;
+}
+constexpr XKind xkind_of(Result (*)(StackTop, int64_t, ExecutionState&) noexcept) noexcept
+{
+    return XK_GAS;
+}
+constexpr XKind xkind_of(TermResult (*)(StackTop, int64_t, ExecutionState&) noexcept) noexcept
+{
+    return XK_TERM;
+}
+constexpr XKind xkind_of(
+    code_iterator (*)(StackTop, ExecutionState&, code_iterator) noexcept) noexcept
+{
+    return XK_CODEIT;
+}
+
+struct XOpInfo
+{
+    XKind kind;
+    uint8_t req;    ///< stack_height_required
+    int8_t change;  ///< stack_height_change
+};
+
+constexpr std::array<XOpInfo, 256> make_xinfo() noexcept
+{
+    std::array<XOpInfo, 256> t{};
+#define ON_OPCODE(OPCODE)                                                                 \
+    t[OPCODE] = {xkind_of(instr::core::impl<OPCODE>), instr::traits[OPCODE].stack_height_required, \
+        instr::traits[OPCODE].stack_height_change};
+    MAP_OPCODES
+#undef ON_OPCODE
+    return t;
+}
+inline constexpr auto kXInfo = make_xinfo();
+
+/// Special record handlers (indices into the dispatch's xs[] label table).
+enum XSpecial : int
+{
+    XS_ENTER,     ///< [h, gas32|need_bytes16|grow16, pc]  segment header
+    XS_GOTO,      ///< [h, seg, pc]                         continue into the next segment
+    XS_FALLBACK,  ///< [h, pc]                              hand over to dispatch_cgoto
+    XS_PUSH1W,    ///< [h, w0]                              PUSH1..8
+    XS_PUSH2W,    ///< [h, w0, w1]                          PUSH9..16
+    XS_PUSH3W,    ///< [h, w0, w1, w2]                      PUSH17..24
+    XS_PUSH4W,    ///< [h, w0, w1, w2, w3]                  PUSH25..32
+    XS_PC,        ///< [h, pc]
+    XS_JUMP,      ///< [h, cached dst, cached seg]
+    XS_JUMPI,     ///< [h, fall seg, pc next, cached dst, cached seg]
+    XS_SJUMP,     ///< [h, seg, dst]                        PUSH1/2 JUMP
+    XS_BR_NZ,     ///< [h, taken seg, fall seg, dst|pcnext<<32]   PUSH1/2 JUMPI
+    XS_BR_ISZERO,
+    XS_BR_EQ,
+    XS_BR_LT,
+    XS_BR_GT,
+    XS_BR_SLT,
+    XS_BR_SGT,
+    XS_BR_P4EQ,  ///< [h, taken seg, fall seg, dst|pcnext<<32, imm32]  PUSH4 EQ PUSH1/2 JUMPI
+    XS_BADJUMP,  ///< [h]
+    XS_COUNT
+};
+
+struct XState
+{
+    struct Ent
+    {
+        uint64_t key;
+        XWord* seg;
+    };
+    Ent* tab = nullptr;
+    uint64_t mask = 0;
+    unsigned shift = 64;
+    size_t used = 0;
+    XWord* cur = nullptr;
+    XWord* end = nullptr;
+    XWord* chunks = nullptr;  ///< singly linked through word 0
+    XWord* bad = nullptr;     ///< shared bad-jump record
+    size_t bytes = 0;
+    int depth = 0;  ///< live dispatch_xlat frames (the arena is only reset at 0)
+};
+inline XState g_x;
+struct XDescTab;
+inline XDescTab* g_xdesc[4];  ///< per-revision translator tables (see xdesc)
+
+inline void xreset() noexcept
+{
+    for (auto* c = g_x.chunks; c != nullptr;)
+    {
+        auto* next = reinterpret_cast<XWord*>(c[0]);
+        std::free(c);
+        c = next;
+    }
+    std::free(g_x.tab);
+    g_x = XState{};
+    for (auto& t : g_xdesc)
+    {
+        std::free(t);
+        t = nullptr;
+    }
+}
+
+[[gnu::noinline]] inline bool xreserve(size_t words) noexcept
+{
+    if (static_cast<size_t>(g_x.end - g_x.cur) >= words)
+        return true;
+    const size_t n = std::max(words, kXChunkWords) + 1;
+    if (g_x.bytes + n * sizeof(XWord) > kXBudget)
+        return false;
+    auto* c = static_cast<XWord*>(std::malloc(n * sizeof(XWord)));
+    if (c == nullptr)
+        return false;
+    g_x.bytes += n * sizeof(XWord);
+    c[0] = reinterpret_cast<XWord>(g_x.chunks);
+    g_x.chunks = c;
+    g_x.cur = c + 1;
+    g_x.end = c + n;
+    return true;
+}
+
+[[gnu::always_inline]] inline XWord* xfind(uint64_t key) noexcept
+{
+    if (g_x.tab == nullptr)
+        return nullptr;
+    auto i = (key * 0x9E3779B97F4A7C15ull) >> g_x.shift;
+    while (true)
+    {
+        const auto& e = g_x.tab[i];
+        if (e.key == key)
+            return e.seg;
+        if (e.seg == nullptr)
+            return nullptr;
+        i = (i + 1) & g_x.mask;
+    }
+}
+
+[[gnu::noinline]] inline bool xinsert(uint64_t key, XWord* seg) noexcept
+{
+    if (g_x.tab == nullptr || (g_x.used + 1) * 2 > g_x.mask + 1)
+    {
+        const unsigned bits = g_x.tab == nullptr ? 15 : 64 - g_x.shift + 1;
+        const size_t n = size_t{1} << bits;
+        const size_t old_n = g_x.tab == nullptr ? 0 : g_x.mask + 1;
+        if (g_x.bytes + n * sizeof(XState::Ent) > kXBudget)
+            return false;
+        auto* t = static_cast<XState::Ent*>(std::calloc(n, sizeof(XState::Ent)));
+        if (t == nullptr)
+            return false;
+        const auto mask = n - 1;
+        const auto shift = 64 - bits;
+        for (size_t j = 0; j < old_n; ++j)
+        {
+            const auto& e = g_x.tab[j];
+            if (e.seg == nullptr)
+                continue;
+            auto i = (e.key * 0x9E3779B97F4A7C15ull) >> shift;
+            while (t[i].seg != nullptr)
+                i = (i + 1) & mask;
+            t[i] = e;
+        }
+        std::free(g_x.tab);
+        g_x.bytes = g_x.bytes - old_n * sizeof(XState::Ent) + n * sizeof(XState::Ent);
+        g_x.tab = t;
+        g_x.mask = mask;
+        g_x.shift = shift;
+    }
+    auto i = (key * 0x9E3779B97F4A7C15ull) >> g_x.shift;
+    while (g_x.tab[i].seg != nullptr)
+        i = (i + 1) & g_x.mask;
+    g_x.tab[i] = {key, seg};
+    ++g_x.used;
+    return true;
+}
+
+/// Per-revision opcode descriptors for the translator: the record handler, base gas,
+/// stack effect and how the opcode is translated.
+enum XClass : uint8_t
+{
+    XC_PLAIN,    ///< [handler]
+    XC_GAS,      ///< [handler, rem | pc next << 32]
+    XC_TERM,     ///< [handler], ends the segment
+    XC_PUSH,     ///< PUSH1..PUSH32 (may start a fused jump)
+    XC_TEST,     ///< ISZERO/EQ/LT/GT/SLT/SGT: plain unless followed by PUSH1/2 JUMPI
+    XC_SPECIAL,  ///< JUMPDEST, JUMP, JUMPI, PC, and everything handed over
+};
+
+struct XDesc
+{
+    XWord h;
+    int32_t cost;
+    int8_t req;
+    int8_t chg;
+    uint8_t cls;
+    uint8_t len;  ///< PUSH data bytes
+};
+
+struct XDescTab
+{
+    const CostTable* ct;
+    XDesc d[256];
+};
+
+
+[[gnu::noinline]] const XDesc* xdesc_build(
+    const void* const* xops, const void* const* xs, const CostTable& ct) noexcept
+{
+    int slot = 0;
+    while (slot < 4 && g_xdesc[slot] != nullptr)
+        ++slot;
+    if (slot == 4)
+        return nullptr;
+    auto* t = static_cast<XDescTab*>(std::malloc(sizeof(XDescTab)));
+    if (t == nullptr)
+        return nullptr;
+    t->ct = &ct;
+    for (int op = 0; op < 256; ++op)
+    {
+        const auto& inf = kXInfo[static_cast<size_t>(op)];
+        auto& d = t->d[op];
+        d.cost = ct[static_cast<size_t>(op)];
+        d.req = static_cast<int8_t>(inf.req);
+        d.chg = inf.change;
+        d.len = 0;
+        d.h = reinterpret_cast<XWord>(xops[op]);
+        if (d.cost < 0 || inf.kind == XK_NONE)
+            d.cls = XC_SPECIAL;
+        else if (op >= OP_PUSH1 && op <= OP_PUSH32)
+        {
+            d.cls = XC_PUSH;
+            d.len = static_cast<uint8_t>(op - OP_PUSH1 + 1);
+            d.h = reinterpret_cast<XWord>(xs[XS_PUSH1W + (d.len + 7) / 8 - 1]);
+        }
+        else if (op == OP_JUMPDEST || op == OP_JUMP || op == OP_JUMPI || op == OP_PC ||
+                 inf.kind == XK_CODEIT)
+            d.cls = XC_SPECIAL;
+        else if (op == OP_ISZERO || op == OP_EQ || op == OP_LT || op == OP_GT || op == OP_SLT ||
+                 op == OP_SGT)
+            d.cls = XC_TEST;
+        else if (inf.kind == XK_GAS)
+            d.cls = XC_GAS;
+        else if (inf.kind == XK_TERM)
+            d.cls = XC_TERM;
+        else
+            d.cls = XC_PLAIN;
+    }
+    g_xdesc[slot] = t;
+    g_x.bytes += sizeof(XDescTab);
+    return t->d;
+}
+
+[[gnu::always_inline]] inline const XDesc* xdesc(
+    const void* const* xops, const void* const* xs, const CostTable& ct) noexcept
+{
+    for (int i = 0; i < 4 && g_xdesc[i] != nullptr; ++i)
+        if (g_xdesc[i]->ct == &ct)
+            return g_xdesc[i]->d;
+    return xdesc_build(xops, xs, ct);
+}
+
+/// Big-endian immediate of `n` (<= 8) bytes at `p`.
+[[gnu::always_inline]] inline uint64_t ximm(const uint8_t* p, int n) noexcept
+{
+    uint64_t v = 0;
+    for (int i = 0; i < n; ++i)
+        v = (v << 8) | p[i];
+    return v;
+}
+
+/// Translate the segment starting at `pc` (an opcode boundary of `a`'s padded code) and
+/// register it under `key`. Returns the segment header, or nullptr when the budget is
+/// exhausted (the caller then hands over to dispatch_cgoto).
+[[gnu::noinline]] XWord* xtranslate(const void* const* xops, const void* const* xs,
+    const CodeAnalysis& a, const CostTable& ct, uint64_t key, uint32_t pc) noexcept
+{
+    constexpr ptrdiff_t kMaxWords = kXMaxOps * 5 + 16;
+    const XDesc* const D = xdesc(xops, xs, ct);
+    if (D == nullptr)
+        return nullptr;
+    if (g_x.end - g_x.cur < kMaxWords && !xreserve(kMaxWords))
+        return nullptr;
+    const uint8_t* const code = a.code().data();
+    XWord* const seg = g_x.cur;
+    seg[0] = reinterpret_cast<XWord>(xs[XS_ENTER]);
+    seg[2] = pc;
+    XWord* w = seg + 3;
+
+    int64_t gsum = 0;
+    int h = 0;     // stack height relative to entry
+    int need = 0;  // items the segment needs at entry
+    int grow = 0;  // max height reached (<= kXGrowCap)
+    const uint8_t* p = code + pc;
+    XWord* gas_rec[kXMaxOps];  // aux words of XC_GAS records (hold the base gas so far)
+    int ng = 0;
+
+#define XSTK(REQ, CHG)               \
+    do                               \
+    {                                \
+        const int t_ = (REQ) - h;    \
+        if (t_ > need)               \
+            need = t_;               \
+        h += (CHG);                  \
+        if (h > grow)                \
+            grow = h;                \
+    } while (0)
+#define XPC(PTR) static_cast<uint64_t>((PTR) - code)
+
+    if (*p == OP_JUMPDEST)
+    {
+        gsum += ct[OP_JUMPDEST];
+        ++p;
+    }
+
+    for (int n = 0;; ++n)
+    {
+        const uint8_t op = *p;
+        const XDesc& d = D[op];
+        // Every opcode or fused pattern grows the stack by at most one at any point, so
+        // h < kXGrowCap keeps the segment's growth within the cap.
+        if (n == kXMaxOps || h >= kXGrowCap) [[unlikely]]
+            goto split;
+        switch (d.cls)
+        {
+        case XC_PLAIN:
+            w[0] = d.h;
+            w += 1;
+            XSTK(d.req, d.chg);
+            gsum += d.cost;
+            ++p;
+            continue;
+        case XC_GAS:
+            XSTK(d.req, d.chg);
+            gsum += d.cost;
+            w[0] = d.h;
+            w[1] = (XPC(p + 1) << 32) | static_cast<uint32_t>(gsum);
+            gas_rec[ng++] = w + 1;
+            w += 2;
+            ++p;
+            continue;
+        case XC_TERM:
+            w[0] = d.h;
+            w += 1;
+            XSTK(d.req, d.chg);
+            gsum += d.cost;
+            ++p;
+            goto done;
+        case XC_PUSH:
+        {
+            const int len = d.len;
+            if (len <= 2)
+            {
+                const uint8_t nx = p[1 + len];
+                if (nx == OP_JUMP)
+                {
+                    XSTK(0, 1);
+                    XSTK(1, -1);
+                    gsum += d.cost + ct[OP_JUMP];
+                    w[0] = reinterpret_cast<XWord>(xs[XS_SJUMP]);
+                    w[1] = 0;
+                    w[2] = ximm(p + 1, len);
+                    w += 3;
+                    goto done;
+                }
+                if (nx == OP_JUMPI)
+                {
+                    XSTK(0, 1);
+                    XSTK(2, -2);
+                    gsum += d.cost + ct[OP_JUMPI];
+                    w[0] = reinterpret_cast<XWord>(xs[XS_BR_NZ]);
+                    w[1] = 0;
+                    w[2] = 0;
+                    w[3] = ximm(p + 1, len) | (XPC(p + 2 + len) << 32);
+                    w += 4;
+                    goto done;
+                }
+            }
+            else if (len == 4 && p[5] == OP_EQ && (p[6] == OP_PUSH1 || p[6] == OP_PUSH2))
+            {
+                const int len2 = p[6] - OP_PUSH1 + 1;
+                if (p[7 + len2] == OP_JUMPI)
+                {
+                    XSTK(0, 1);
+                    XSTK(2, -1);
+                    XSTK(0, 1);
+                    XSTK(2, -2);
+                    gsum += d.cost + ct[OP_EQ] + ct[p[6]] + ct[OP_JUMPI];
+                    w[0] = reinterpret_cast<XWord>(xs[XS_BR_P4EQ]);
+                    w[1] = 0;
+                    w[2] = 0;
+                    w[3] = ximm(p + 7, len2) | (XPC(p + 8 + len2) << 32);
+                    w[4] = ximm(p + 1, 4);
+                    w += 5;
+                    goto done;
+                }
+            }
+            XSTK(0, 1);
+            gsum += d.cost;
+            w[0] = d.h;
+            if (len <= 8)
+            {
+                w[1] = ximm(p + 1, len);
+                w += 2;
+            }
+            else
+            {
+                // Limb j (least significant first) holds data bytes [len-8(j+1), len-8j).
+                const int words = (len + 7) / 8;
+                for (int j = 0; j < words; ++j)
+                {
+                    const int hi = len - 8 * j;
+                    const int lo = hi > 8 ? hi - 8 : 0;
+                    w[1 + j] = ximm(p + 1 + lo, hi - lo);
+                }
+                w += 1 + words;
+            }
+            p += 1 + len;
+            continue;
+        }
+        case XC_TEST:
+        {
+            const uint8_t p2 = p[1];
+            if (p2 == OP_PUSH1 || p2 == OP_PUSH2)
+            {
+                const int len = p2 - OP_PUSH1 + 1;
+                if (p[2 + len] == OP_JUMPI)
+                {
+                    XSTK(d.req, d.chg);
+                    XSTK(0, 1);
+                    XSTK(2, -2);
+                    gsum += d.cost + ct[p2] + ct[OP_JUMPI];
+                    const int s = op == OP_ISZERO ? XS_BR_ISZERO :
+                                  op == OP_EQ     ? XS_BR_EQ :
+                                  op == OP_LT     ? XS_BR_LT :
+                                  op == OP_GT     ? XS_BR_GT :
+                                  op == OP_SLT    ? XS_BR_SLT :
+                                                    XS_BR_SGT;
+                    w[0] = reinterpret_cast<XWord>(xs[s]);
+                    w[1] = 0;
+                    w[2] = 0;
+                    w[3] = ximm(p + 2, len) | (XPC(p + 3 + len) << 32);
+                    w += 4;
+                    goto done;
+                }
+            }
+            w[0] = d.h;
+            w += 1;
+            XSTK(d.req, d.chg);
+            gsum += d.cost;
+            ++p;
+            continue;
+        }
+        default:  // XC_SPECIAL
+            if (op == OP_JUMPDEST)
+                goto split;
+            if (d.cost < 0 || (op != OP_JUMP && op != OP_JUMPI && op != OP_PC))
+            {
+                // Undefined in this revision, or DUPN/SWAPN/EXCHANGE: the hand-over
+                // runs (and checks) it.
+                w[0] = reinterpret_cast<XWord>(xs[XS_FALLBACK]);
+                w[1] = XPC(p);
+                w += 2;
+                goto done;
+            }
+            XSTK(d.req, d.chg);
+            gsum += d.cost;
+            if (op == OP_PC)
+            {
+                w[0] = reinterpret_cast<XWord>(xs[XS_PC]);
+                w[1] = XPC(p);
+                w += 2;
+                ++p;
+                continue;
+            }
+            if (op == OP_JUMP)
+            {
+                w[0] = reinterpret_cast<XWord>(xs[XS_JUMP]);
+                w[1] = ~uint64_t{0};
+                w[2] = reinterpret_cast<XWord>(g_x.bad);
+                w += 3;
+                goto done;
+            }
+            w[0] = reinterpret_cast<XWord>(xs[XS_JUMPI]);
+            w[1] = 0;
+            w[2] = XPC(p + 1);
+            w[3] = ~uint64_t{0};
+            w[4] = reinterpret_cast<XWord>(g_x.bad);
+            w += 5;
+            goto done;
+        }
+    }
+split:
+    w[0] = reinterpret_cast<XWord>(xs[XS_GOTO]);
+    w[1] = 0;
+    w[2] = XPC(p);
+    w += 3;
+done:
+#undef XSTK
+#undef XPC
+    for (int i = 0; i < ng; ++i)
+    {
+        const auto v = *gas_rec[i];
+        *gas_rec[i] = (v & ~uint64_t{0xffffffff}) |
+                      static_cast<uint32_t>(gsum - static_cast<uint32_t>(v));
+    }
+    seg[1] = static_cast<uint64_t>(static_cast<uint32_t>(gsum)) |
+             (static_cast<uint64_t>(need * 32) << 32) | (static_cast<uint64_t>(grow) << 48);
+    g_x.cur = w;
+    if (!xinsert(key, seg))
+        return nullptr;
+    return seg;
+}
+
+enum XAction : int
+{
+    XA_NEXT,
+    XA_EXIT,      ///< return `ret`
+    XA_HANDOVER,  ///< continue in dispatch_cgoto at `hpc` with gas `ret`
+};
+
+/// One translated generic opcode (no checks: the segment entry did them).
+template <Opcode Op>
+[[gnu::always_inline]] inline XAction xexec(uint256*& sp, XWord*& ip, int64_t& gas,
+    ExecutionState& state, int64_t& ret, uint64_t& hpc) noexcept
+{
+    __builtin_assume(gas >= 0);
+    constexpr auto k = xkind_of(instr::core::impl<Op>);
+    constexpr auto change = instr::traits[Op].stack_height_change;
+    if constexpr (k == XK_PLAIN)
+    {
+        instr::core::impl<Op>(sp);
+        sp += change;
+        ip += 1;
+        return XA_NEXT;
+    }
+    else if constexpr (k == XK_PLAIN_S)
+    {
+        instr::core::impl<Op>(sp, state);
+        sp += change;
+        ip += 1;
+        return XA_NEXT;
+    }
+    else if constexpr (k == XK_GAS)
+    {
+        // The gas the per-opcode interpreter would pass: add back the base gas of the
+        // opcodes after this one, precharged at segment entry (aux low word).
+        const auto aux = ip[1];
+        const int64_t rem = static_cast<uint32_t>(aux);
+        const auto r = instr::core::impl<Op>(sp, gas + rem, state);
+        if (r.status != EVMC_SUCCESS) [[unlikely]]
+        {
+            state.status = r.status;
+            ret = r.gas_left;
+            return XA_EXIT;
+        }
+        sp += change;
+        gas = r.gas_left - rem;
+        if (gas < 0) [[unlikely]]
+        {
+            ret = r.gas_left;
+            hpc = aux >> 32;
+            return XA_HANDOVER;
+        }
+        ip += 2;
+        return XA_NEXT;
+    }
+    else if constexpr (k == XK_TERM)
+    {
+        const auto r = instr::core::impl<Op>(sp, gas, state);
+        state.status = r.status;
+        ret = r.gas_left;
+        return XA_EXIT;
+    }
+    else
+    {
+        __builtin_trap();
+    }
+}
+
+int64_t dispatch_xlat(const CostTable& cost_table, ExecutionState& state, int64_t gas,
+    const CodeAnalysis& analysis) noexcept
+{
+    static constexpr void* xops[] = {
+#define ON_OPCODE(OPCODE) &&XOP_##OPCODE,
+#undef ON_OPCODE_UNDEFINED
+#define ON_OPCODE_UNDEFINED(_) &&X_FALLBACK,
+        MAP_OPCODES
+#undef ON_OPCODE
+#undef ON_OPCODE_UNDEFINED
+#define ON_OPCODE_UNDEFINED ON_OPCODE_UNDEFINED_DEFAULT
+    };
+    static_assert(std::size(xops) == 256);
+    static constexpr void* xs[] = {&&X_ENTER, &&X_GOTO, &&X_FALLBACK, &&X_PUSH1W, &&X_PUSH2W,
+        &&X_PUSH3W, &&X_PUSH4W, &&X_PC, &&X_JUMP, &&X_JUMPI, &&X_SJUMP, &&X_BR_NZ,
+        &&X_BR_ISZERO, &&X_BR_EQ, &&X_BR_LT, &&X_BR_GT, &&X_BR_SLT, &&X_BR_SGT, &&X_BR_P4EQ,
+        &&X_BADJUMP};
+    static_assert(std::size(xs) == XS_COUNT);
+
+    const uint8_t* const code = analysis.code().data();
+    uint256* const bottom = state.stack_space.bottom();
+    const uint256* const lim = bottom + (StackSpace::limit - kXGrowCap);
+    const uint64_t kbase = (uint64_t{analysis.xid()} << 32) |
+                           (uint64_t{static_cast<uint8_t>(state.rev)} << 24);
+
+    if (g_x.depth == 0 && g_x.bytes > kXBudget / 2)
+        xreset();
+    if (g_x.bad == nullptr)
+    {
+        if (!xreserve(1))
+            return dispatch_cgoto(cost_table, state, gas, code, Position{code, bottom});
+        g_x.bad = g_x.cur++;
+        g_x.bad[0] = reinterpret_cast<XWord>(&&X_BADJUMP);
+    }
+
+    XWord* ip = xfind(kbase);
+    if (ip == nullptr)
+        ip = xtranslate(xops, xs, analysis, cost_table, kbase, 0);
+    if (ip == nullptr)
+        return dispatch_cgoto(cost_table, state, gas, code, Position{code, bottom});
+
+    uint256* sp = bottom;
+    XWord* patch = nullptr;  // record word to patch with a resolved segment
+    uint64_t rpc = 0;        // pc to resolve
+    ++g_x.depth;
+
+#define XNEXT() goto* reinterpret_cast<void*>(*ip)
+#define XEXIT(G)          \
+    do                    \
+    {                     \
+        --g_x.depth;      \
+        return (G);       \
+    } while (0)
+#define XHANDOVER(PC, G)                                                                  \
+    do                                                                                    \
+    {                                                                                     \
+        --g_x.depth;                                                                      \
+        return dispatch_cgoto(                                                            \
+            cost_table, state, (G), code, Position{code + static_cast<size_t>(PC), sp}); \
+    } while (0)
+
+    XNEXT();
+
+X_ENTER:
+{
+    ASM_COMMENT(X_ENTER);
+    const int64_t c = reinterpret_cast<const uint32_t*>(ip + 1)[0];
+    const auto need = reinterpret_cast<const uint16_t*>(ip + 1)[2];
+    gas -= c;
+    if (gas < 0 ||
+        reinterpret_cast<uintptr_t>(sp) - need < reinterpret_cast<uintptr_t>(bottom)) [[unlikely]]
+        goto X_ENTER_FAIL;
+    if (sp > lim) [[unlikely]]
+    {
+        const auto grow = reinterpret_cast<const uint16_t*>(ip + 1)[3];
+        if (sp + grow > bottom + StackSpace::limit)
+            goto X_ENTER_FAIL;
+    }
+    ip += 3;
+    XNEXT();
+X_ENTER_FAIL:
+    XHANDOVER(ip[2], gas + c);
+}
+
+X_GOTO:
+{
+    ASM_COMMENT(X_GOTO);
+    auto* s = reinterpret_cast<XWord*>(ip[1]);
+    if (s != nullptr) [[likely]]
+    {
+        ip = s;
+        XNEXT();
+    }
+    patch = ip + 1;
+    rpc = ip[2];
+    goto X_RESOLVE;
+}
+
+X_FALLBACK:
+    ASM_COMMENT(X_FALLBACK);
+    XHANDOVER(ip[1], gas);
+
+X_PUSH1W:
+{
+    ASM_COMMENT(X_PUSH1W);
+    auto& r = *sp;
+    r[0] = ip[1];
+    r[1] = 0;
+    r[2] = 0;
+    r[3] = 0;
+    ++sp;
+    ip += 2;
+    XNEXT();
+}
+X_PUSH2W:
+{
+    auto& r = *sp;
+    r[0] = ip[1];
+    r[1] = ip[2];
+    r[2] = 0;
+    r[3] = 0;
+    ++sp;
+    ip += 3;
+    XNEXT();
+}
+X_PUSH3W:
+{
+    auto& r = *sp;
+    r[0] = ip[1];
+    r[1] = ip[2];
+    r[2] = ip[3];
+    r[3] = 0;
+    ++sp;
+    ip += 4;
+    XNEXT();
+}
+X_PUSH4W:
+{
+    auto& r = *sp;
+    r[0] = ip[1];
+    r[1] = ip[2];
+    r[2] = ip[3];
+    r[3] = ip[4];
+    ++sp;
+    ip += 5;
+    XNEXT();
+}
+X_PC:
+{
+    auto& r = *sp;
+    r[0] = ip[1];
+    r[1] = 0;
+    r[2] = 0;
+    r[3] = 0;
+    ++sp;
+    ip += 2;
+    XNEXT();
+}
+
+X_JUMP:
+{
+    ASM_COMMENT(X_JUMP);
+    const auto& d = sp[-1];
+    --sp;
+    if ((d[3] | d[2] | d[1]) != 0) [[unlikely]]
+        goto X_BADJUMP;
+    rpc = d[0];
+    if (rpc == ip[1]) [[likely]]
+    {
+        ip = reinterpret_cast<XWord*>(ip[2]);
+        XNEXT();
+    }
+    patch = ip + 1;
+    goto X_RESOLVE_DYN;
+}
+
+X_JUMPI:
+{
+    ASM_COMMENT(X_JUMPI);
+    const auto& d = sp[-1];
+    const auto& c = sp[-2];
+    sp -= 2;
+    if ((c[0] | c[1] | c[2] | c[3]) == 0)
+    {
+        auto* s = reinterpret_cast<XWord*>(ip[1]);
+        if (s != nullptr) [[likely]]
+        {
+            ip = s;
+            XNEXT();
+        }
+        patch = ip + 1;
+        rpc = ip[2];
+        goto X_RESOLVE;
+    }
+    if ((d[3] | d[2] | d[1]) != 0) [[unlikely]]
+        goto X_BADJUMP;
+    rpc = d[0];
+    if (rpc == ip[3]) [[likely]]
+    {
+        ip = reinterpret_cast<XWord*>(ip[4]);
+        XNEXT();
+    }
+    patch = ip + 3;
+    goto X_RESOLVE_DYN;
+}
+
+X_SJUMP:
+{
+    ASM_COMMENT(X_SJUMP);
+    auto* s = reinterpret_cast<XWord*>(ip[1]);
+    if (s != nullptr) [[likely]]
+    {
+        ip = s;
+        XNEXT();
+    }
+    patch = ip + 1;
+    rpc = ip[2];
+    goto X_RESOLVE_JD;
+}
+
+#define X_BR_TAIL(TAKEN)                                        \
+    do                                                          \
+    {                                                           \
+        if (TAKEN)                                              \
+        {                                                       \
+            auto* s = reinterpret_cast<XWord*>(ip[1]);          \
+            if (s != nullptr) [[likely]]                        \
+            {                                                   \
+                ip = s;                                         \
+                XNEXT();                                        \
+            }                                                   \
+            patch = ip + 1;                                     \
+            rpc = static_cast<uint32_t>(ip[3]);                 \
+            goto X_RESOLVE_JD;                                  \
+        }                                                       \
+        auto* s = reinterpret_cast<XWord*>(ip[2]);              \
+        if (s != nullptr) [[likely]]                            \
+        {                                                       \
+            ip = s;                                             \
+            XNEXT();                                            \
+        }                                                       \
+        patch = ip + 2;                                         \
+        rpc = ip[3] >> 32;                                      \
+        goto X_RESOLVE;                                         \
+    } while (0)
+
+X_BR_NZ:
+{
+    ASM_COMMENT(X_BR_NZ);
+    const auto& a = sp[-1];
+    const bool t = (a[0] | a[1] | a[2] | a[3]) != 0;
+    sp -= 1;
+    X_BR_TAIL(t);
+}
+X_BR_ISZERO:
+{
+    ASM_COMMENT(X_BR_ISZERO);
+    const auto& a = sp[-1];
+    const bool t = (a[0] | a[1] | a[2] | a[3]) == 0;
+    sp -= 1;
+    X_BR_TAIL(t);
+}
+X_BR_EQ:
+{
+    ASM_COMMENT(X_BR_EQ);
+    const auto& a = sp[-1];
+    const auto& b = sp[-2];
+    const bool t = ((a[0] ^ b[0]) | (a[1] ^ b[1]) | (a[2] ^ b[2]) | (a[3] ^ b[3])) == 0;
+    sp -= 2;
+    X_BR_TAIL(t);
+}
+X_BR_LT:
+{
+    const bool t = sp[-1] < sp[-2];
+    sp -= 2;
+    X_BR_TAIL(t);
+}
+X_BR_GT:
+{
+    const bool t = sp[-2] < sp[-1];
+    sp -= 2;
+    X_BR_TAIL(t);
+}
+X_BR_SLT:
+{
+    const bool t = intx::slt(sp[-1], sp[-2]);
+    sp -= 2;
+    X_BR_TAIL(t);
+}
+X_BR_SGT:
+{
+    const bool t = intx::slt(sp[-2], sp[-1]);
+    sp -= 2;
+    X_BR_TAIL(t);
+}
+X_BR_P4EQ:
+{
+    ASM_COMMENT(X_BR_P4EQ);
+    const auto& a = sp[-1];
+    const bool t = a[0] == ip[4] && (a[1] | a[2] | a[3]) == 0;
+    sp -= 1;
+    X_BR_TAIL(t);
+}
+#undef X_BR_TAIL
+
+X_BADJUMP:
+    state.status = EVMC_BAD_JUMP_DESTINATION;
+    XEXIT(gas);
+
+X_RESOLVE_DYN:
+    // A dynamic target that missed the record's one-entry cache: validate it like
+    // jump_impl, then cache (dst, segment) in the record.
+    if (!analysis.check_jumpdest(rpc)) [[unlikely]]
+        goto X_BADJUMP;
+    {
+        XWord* s = xfind(kbase | rpc);
+        if (s == nullptr)
+            s = xtranslate(xops, xs, analysis, cost_table, kbase | rpc, static_cast<uint32_t>(rpc));
+        if (s == nullptr)
+            XHANDOVER(rpc, gas);
+        patch[0] = rpc;
+        patch[1] = reinterpret_cast<XWord>(s);
+        ip = s;
+        XNEXT();
+    }
+
+X_RESOLVE_JD:
+    // A static target, validated once: the record keeps the segment or the bad-jump record.
+    if (!analysis.check_jumpdest(rpc)) [[unlikely]]
+    {
+        *patch = reinterpret_cast<XWord>(g_x.bad);
+        goto X_BADJUMP;
+    }
+X_RESOLVE:
+{
+    XWord* s = xfind(kbase | rpc);
+    if (s == nullptr)
+        s = xtranslate(xops, xs, analysis, cost_table, kbase | rpc, static_cast<uint32_t>(rpc));
+    if (s == nullptr)
+        XHANDOVER(rpc, gas);
+    *patch = reinterpret_cast<XWord>(s);
+    ip = s;
+    XNEXT();
+}
+
+#define ON_OPCODE(OPCODE)                                                         \
+    XOP_##OPCODE:                                                                 \
+    {                                                                             \
+        ASM_COMMENT(XOP_##OPCODE);                                                \
+        int64_t ret;                                                              \
+        uint64_t hpc;                                                             \
+        const auto act = xexec<OPCODE>(sp, ip, gas, state, ret, hpc);             \
+        if (act == XA_NEXT) [[likely]]                                            \
+            XNEXT();                                                              \
+        if (act == XA_EXIT)                                                       \
+            XEXIT(ret);                                                           \
+        XHANDOVER(hpc, ret);                                                      \
+    }
+
+    MAP_OPCODES
+#undef ON_OPCODE
+#undef XNEXT
+#undef XEXIT
+#undef XHANDOVER
+}
