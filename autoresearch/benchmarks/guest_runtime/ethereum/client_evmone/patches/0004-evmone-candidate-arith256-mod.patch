 #if defined(ZEG_ZISK)
     zkvm_u256_le_mulmod(zeg_u256::le(x), zeg_u256::le(y), zeg_u256::le(m), zeg_u256::le(m));
+#elif defined(CANDIDATE_ARITH)
+    {
+        const intx::uint256 zero = 0;
+        intx::uint256 r;
+        stwo_arith256_mod(&x[0], &y[0], &zero[0], &m[0], &r[0]);
+        m = r;
+    }
 #else
     m = m != 0 ? intx::mulmod(x, y, m) : 0;
 #endif
