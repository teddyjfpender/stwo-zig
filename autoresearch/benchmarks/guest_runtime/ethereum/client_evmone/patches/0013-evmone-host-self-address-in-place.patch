+/// stwo RV64IM: call the Host's C interface with the frame's own address in place.
+/// The C++ wrappers take `const evmc::address&`, so passing msg->recipient (an
+/// evmc_address) copied its 20 unaligned bytes into a temporary, byte by byte, on
+/// every SLOAD/SSTORE/TLOAD/TSTORE/LOG (~55 instructions each time).
+#define STWO_HOST_SELF(state, fn, ...) \
+    (state).host.raw_interface()->fn((state).host.raw_context(), &(state).msg->recipient, __VA_ARGS__)
+
 
 /// Swap two values.
