+#if defined(__riscv) && !defined(__riscv_zbb)
+// stwo RV64IM guest: without Zbb a 64-bit byte swap costs ~32 instructions and
+// an unaligned 8-byte memcpy ~22 more, while assembling a big-endian word from
+// bytes directly costs ~29 (and storing one ~15), so the big-endian
+// conversions below go byte-wise instead of memcpy + bswap.
+#define INTX_BE_BYTEWISE 1
+namespace be_bytes
+{
+inline uint64_t load64(const uint8_t* p) noexcept
+{
+    return (uint64_t{p[0]} << 56) | (uint64_t{p[1]} << 48) | (uint64_t{p[2]} << 40) |
+           (uint64_t{p[3]} << 32) | (uint64_t{p[4]} << 24) | (uint64_t{p[5]} << 16) |
+           (uint64_t{p[6]} << 8) | uint64_t{p[7]};
+}
+inline void store64(uint8_t* p, uint64_t v) noexcept
+{
+    p[0] = static_cast<uint8_t>(v >> 56);
+    p[1] = static_cast<uint8_t>(v >> 48);
+    p[2] = static_cast<uint8_t>(v >> 40);
+    p[3] = static_cast<uint8_t>(v >> 32);
+    p[4] = static_cast<uint8_t>(v >> 24);
+    p[5] = static_cast<uint8_t>(v >> 16);
+    p[6] = static_cast<uint8_t>(v >> 8);
+    p[7] = static_cast<uint8_t>(v);
+}
+template <typename T>
+inline T load(const uint8_t* src) noexcept
+{
+    if constexpr (std::is_same_v<T, uint64_t>)
+        return load64(src);
+    else
+    {
+        T x;
+        for (size_t i = 0; i < T::num_words; ++i)
+            x[T::num_words - 1 - i] = load64(src + 8 * i);
+        return x;
+    }
+}
+template <typename T>
+inline void store(uint8_t* dst, const T& x) noexcept
+{
+    if constexpr (std::is_same_v<T, uint64_t>)
+        store64(dst, x);
+    else
+        for (size_t i = 0; i < T::num_words; ++i)
+            store64(dst + 8 * i, x[T::num_words - 1 - i]);
+}
+template <typename T>
+inline constexpr bool supported = std::is_same_v<T, uint64_t> || requires { T::num_words; };
+}  // namespace be_bytes
+#endif
