+/// stwo RV64: deferred gas checks in dispatch_cgoto (patch 0030).
+///
+/// A "pure" opcode only reads and writes the EVM stack (and, for PUSHn, reads the code):
+/// no memory, storage, host, gas or control-flow effect. dispatch_cgoto charges such an
+/// opcode's (constant) base cost without testing the result; every other opcode tests
+/// `gas < 0` after charging its own cost, including zero-cost ones (STOP, RETURN, ...).
+/// Gas never increases inside a run of pure opcodes, so if a pure opcode drove gas
+/// negative, the next non-pure opcode reports EVMC_OUT_OF_GAS before it has any effect,
+/// and every failure on the way (stack underflow/overflow, undefined opcode) is reported
+/// as EVMC_OUT_OF_GAS when gas was already negative on entry: exactly the status the
+/// per-opcode check would have produced at the opcode that ran out. The run is finite:
+/// pure opcodes only move forward and the code ends in STOP padding; JUMP/JUMPI and
+/// JUMPDEST are not pure. An exceptional halt zeroes gas_left in make_execution_result,
+/// so the observable result (status, gas_left = 0, no output) is unchanged.
+template <Opcode Op>
+constexpr bool stwo_pure_op() noexcept
+{
+    using Fn = decltype(instr::core::impl<Op>);
+    if constexpr (Op == OP_JUMPDEST)
+        return false;
+    else if constexpr (Op >= OP_PUSH1 && Op <= OP_PUSH32)
+        return true;
+    else
+        return std::is_same_v<std::remove_cv_t<Fn>, void (*)(StackTop) noexcept>;
+}
+static_assert(stwo_pure_op<OP_ADD>() && stwo_pure_op<OP_POP>() && stwo_pure_op<OP_PUSH0>() &&
+              stwo_pure_op<OP_PUSH1>() && stwo_pure_op<OP_PUSH32>() && stwo_pure_op<OP_DUP1>() &&
+              stwo_pure_op<OP_SWAP16>() && stwo_pure_op<OP_ISZERO>() && stwo_pure_op<OP_MULMOD>());
+static_assert(!stwo_pure_op<OP_JUMP>() && !stwo_pure_op<OP_JUMPI>() && !stwo_pure_op<OP_JUMPDEST>() &&
+              !stwo_pure_op<OP_GAS>() && !stwo_pure_op<OP_PC>() && !stwo_pure_op<OP_STOP>() &&
+              !stwo_pure_op<OP_MLOAD>() && !stwo_pure_op<OP_MSTORE>() && !stwo_pure_op<OP_SLOAD>() &&
+              !stwo_pure_op<OP_CALLER>() && !stwo_pure_op<OP_EXP>() && !stwo_pure_op<OP_RETURN>() &&
+              !stwo_pure_op<OP_INVALID>() && !stwo_pure_op<OP_CALL>() && !stwo_pure_op<OP_KECCAK256>());
