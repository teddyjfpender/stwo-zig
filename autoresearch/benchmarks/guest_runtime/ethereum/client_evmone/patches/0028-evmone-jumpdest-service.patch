 namespace evmone::baseline
 {
 static_assert(std::is_move_constructible_v<CodeAnalysis>);
@@ -95,6 +100,31 @@ void analyze_jumpdests_sentinel(BitsetSpan map, uint8_t* padded, size_t code_siz
     std::fill_n(padded + code_size, PADDING, uint8_t{0});
 }
 
+#if defined(STWO_JUMPDEST_SERVICE)
+/// stwo: the whole walk is one jumpdest_bitmap service call on the padded copy. The
+/// service works on whole code words: it analyzes the code size rounded up to 8, whose
+/// extra bytes are the copy's zero padding (never JUMPDESTs; they can only touch bits
+/// at or past the code size, which check_jumpdest never reads), and writes
+/// ceil(size/64) bitmap words in BitsetSpan's layout (the extra bitset word of a size
+/// that is a multiple of 64 stays zero from the fill). The padded copy must be 64-byte
+/// aligned (analyze_into aligns it inside the slot; the heap path of analyze_legacy
+/// usually is not and keeps the sentinel scan), the bitset is word_type aligned, and
+/// the code words end before the bitset, so the service's rules hold. An empty code
+/// (no bitmap word) needs no call.
+void analyze_jumpdests_service(BitsetSpan map, uint8_t* padded, size_t code_size) noexcept
+{
+    if (code_size == 0)
+        return;
+    if (((reinterpret_cast<uintptr_t>(map.m_array) & 7) | (reinterpret_cast<uintptr_t>(padded) & 63)) != 0)
+        [[unlikely]]
+    {
+        analyze_jumpdests_sentinel(map, padded, code_size);
+        return;
+    }
+    stwo::jumpdest_bitmap(map.m_array, padded, (code_size + 7) & ~size_t{7});
+}
+#endif
+
 #if defined(ZEG_JUMPDEST_PRECOMPILE)
 void analyze_jumpdests(BitsetSpan map, bytes_view code) noexcept
 {
