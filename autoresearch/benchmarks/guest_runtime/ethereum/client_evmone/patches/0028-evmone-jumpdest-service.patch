+            __builtin_trap();
+        buffer += skip;
+        capacity -= skip;
+    }
+#endif
     if (total_size > capacity)
         __builtin_trap();  // can't happen: slots are sized to the fork's max analysis
 
@@ -186,6 +229,8 @@ CodeAnalysis analyze_into_impl(bytes_view code, uint8_t* buffer, size_t capacity
     const BitsetSpan jumpdest_bitset{bitset_storage};
 #if defined(ZEG_JUMPDEST_PRECOMPILE)
     analyze_jumpdests(jumpdest_bitset, bytes_view{storage, code.size()});
+#elif defined(STWO_JUMPDEST_SERVICE)
