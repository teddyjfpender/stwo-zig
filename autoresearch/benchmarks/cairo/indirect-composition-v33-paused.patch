+// Bind only for the synchronous evaluation request. No-copy aliases borrow the
+// committed planes; the coordinator clears this binding before their lifetime
+// can end. Misaligned small columns have a strictly bounded copied fallback.
+bool stwo_zig_metal_eval_batch_bind_sources(
+    void *runtime_ptr, void *batch_ptr, const uint32_t *const *columns,
+    const size_t *lengths, uint32_t count, uint64_t copy_budget,
+    uint64_t *copied_bytes, char *error_message, size_t error_message_len
+) {
+    if (runtime_ptr == NULL || batch_ptr == NULL || columns == NULL || lengths == NULL || count == 0u) return false;
+    @autoreleasepool {
+        StwoZigMetalRuntime *runtime = (__bridge StwoZigMetalRuntime *)runtime_ptr;
+        StwoZigEvalBatch *batch = (__bridge StwoZigEvalBatch *)batch_ptr;
+        if (batch.sourceAddresses != nil || batch.sourceBuffers != nil) return false;
+        const size_t page = (size_t)getpagesize();
+        uint64_t copy_total = 0u;
+        // Validate and budget every column before publishing a binding or copy.
+        for (uint32_t i=0u; i<count; ++i) {
+            if (lengths[i]==0u) continue;
+            if (columns[i]==NULL || (uintptr_t)columns[i]%sizeof(uint32_t)!=0u ||
+                lengths[i]>SIZE_MAX/sizeof(uint32_t)) return false;
+            const size_t bytes=lengths[i]*sizeof(uint32_t);
+            if (bytes>runtime.device.maxBufferLength || (uintptr_t)columns[i]>UINTPTR_MAX-bytes) return false;
+            const bool alias=runtime.device.hasUnifiedMemory && (uintptr_t)columns[i]%page==0u && bytes%page==0u;
+            if (!alias) {
+                if (bytes>copy_budget-copy_total) {
+                    write_error(error_message,error_message_len,@"Indirect composition copied-source budget exceeded"); return false;
+                }
+                copy_total+=bytes;
+            }
+        }
+        NSMutableArray<id<MTLBuffer>> *buffers=[NSMutableArray arrayWithCapacity:count];
+        id<MTLBuffer> addresses=[runtime.device newBufferWithLength:(NSUInteger)count*sizeof(uint64_t) options:MTLResourceStorageModeShared];
+        if (buffers==nil || addresses==nil) return false;
+        id<MTLBuffer> zero=[runtime.device newBufferWithLength:2u*sizeof(uint32_t) options:MTLResourceStorageModeShared];
+        if (zero==nil || zero.gpuAddress==0u) return false;
+        ((uint32_t *)zero.contents)[0]=0u; ((uint32_t *)zero.contents)[1]=0u;
+        [buffers addObject:zero];
+        uint64_t *words=addresses.contents;
+        for (uint32_t i=0u; i<count; ++i) {
+            words[i]=zero.gpuAddress;
+            if (lengths[i]==0u) continue;
+            const size_t bytes=lengths[i]*sizeof(uint32_t);
+            const bool alias=runtime.device.hasUnifiedMemory && (uintptr_t)columns[i]%page==0u && bytes%page==0u;
+            id<MTLBuffer> buffer=alias
+                ? [runtime.device newBufferWithBytesNoCopy:(void *)columns[i] length:bytes options:MTLResourceStorageModeShared deallocator:nil]
+                : [runtime.device newBufferWithBytes:columns[i] length:bytes options:MTLResourceStorageModeShared];
+            if (buffer==nil || buffer.gpuAddress==0u) return false;
+            words[i]=buffer.gpuAddress;
+            [buffers addObject:buffer];
+        }
+        batch.sourceBuffers=buffers;
+        batch.sourceAddresses=addresses;
+        if (copied_bytes!=NULL) *copied_bytes=copy_total;
+        return true;
+    }
+}
