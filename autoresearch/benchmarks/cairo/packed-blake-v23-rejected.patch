+fn smallWordOpaque(context: *anyopaque, address: u32) ?u32 {
+    const input: *const adapter.ProverInput = @ptrCast(@alignCast(context));
+    const encoded = addressToId(input, address);
+    if (encoded == memory_mod.EncodedMemoryValueId.EMPTY.raw or encoded >= 0x4000_0000)
+        return null;
+    if (encoded >= input.memory.small_values.len) return 0;
+    // Limb reconstruction consumes exactly the low 32 bits, including for
+    // values with higher limbs. Missing address/value rows retain zero semantics.
+    return @truncate(input.memory.small_values[encoded]);
