    {"label": "b low half", "domain": "range_check_8_8", "numerator": "one", "tuple": [["col", "b0"], ["col", "b1"]]},
    {"label": "b high half", "domain": "range_check_8_8", "numerator": "one", "tuple": [["col", "b2"], ["col", "b3"]]},
    {"label": "sum low half", "domain": "range_check_8_8", "numerator": "one", "tuple": [["col", "s0"], ["col", "s1"]]},
    {"label": "sum high half", "domain": "range_check_8_8", "numerator": "one", "tuple": [["col", "s2"], ["col", "s3"]]}
  ]
