+#!/usr/bin/env python3
+"""Build a pinned Kona host and RV64 guest, retaining source/binary identities."""
+
+import argparse
+import hashlib
+import json
+import os
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+from scripts.riscv64_csp_compare import elf_info
+
+TOOLCHAIN = "nightly-2026-08-08"
+VARIANTS = {
+    "software": None,
+    "keccak": "keccak-service",
+    "services": "services-v3",
+    "sponge": "sponge-service",
+}
+
+
+def identity(path):
+    data = path.read_bytes()
+    return {"bytes": len(data), "sha256": hashlib.sha256(data).hexdigest()}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--artifacts", type=Path, required=True)
+    parser.add_argument(
+        "--variant",
+        choices=(*VARIANTS, "lean", "frontier", "memory", "sha", "memory-sha"),
+        default="software",
+    )
+    parser.add_argument("--eager", action="store_true")
+    parser.add_argument("--jobs", type=int, default=2)
+    args = parser.parse_args()
+    if not 1 <= args.jobs <= 8:
+        parser.error("jobs 1..8")
+    args.artifacts.mkdir(parents=True, exist_ok=True)
+    artifacts = args.artifacts.resolve()
+    crate = ROOT / "opstack/kona"
+    env = dict(
+        os.environ,
+        CARGO_TARGET_DIR=str(crate / "target"),
+        RUSTFLAGS="-C passes=lower-atomic",
+    )
+    commands = []
+    with (artifacts / "build.log").open("w") as log:
+
+        def run(command, custom_env=env):
+            commands.append([str(x) for x in command])
+            subprocess.run(
+                commands[-1],
+                cwd=ROOT,
+                env=custom_env,
+                stdout=log,
+                stderr=subprocess.STDOUT,
+                check=True,
+                timeout=1200,
+            )
+
+        # Same compiler revision, independent native execution backend.
+        host_env = dict(
+            os.environ, CARGO_TARGET_DIR=str(crate / "target"), RUSTFLAGS=""
+        )
+        run(
+            [
+                "cargo",
+                "+" + TOOLCHAIN,
+                "build",
+                "--manifest-path",
+                crate / "Cargo.toml",
+                "--locked",
+                "--release",
+                "--features",
+                "host",
+                "-j",
+                args.jobs,
+            ],
+            host_env,
+        )
+        lean = args.variant in ("lean", "frontier", "memory", "sha", "memory-sha")
+        manifest = crate / ("lean/Cargo.toml" if lean else "Cargo.toml")
+        profile = "frontier" if args.variant in ("frontier", "memory", "sha", "memory-sha") else "release"
+        command = [
+            "cargo",
+            "+" + TOOLCHAIN,
+            "build",
+            "--manifest-path",
+            manifest,
+            "--locked",
+            "--profile",
+            profile,
+            "--target",
+            crate / "guest/riscv64i-stwo.json",
+            "-Z",
+            "json-target-spec",
+            "-Z",
+            "build-std=core,alloc",
+            "-Z",
+            "build-std-features=compiler-builtins-mem",
+            "-j",
+            args.jobs,
+        ]
+        if not lean:
+            command += ["-p", "stwo-kona-rv64-guest"]
+        features = (
+            []
