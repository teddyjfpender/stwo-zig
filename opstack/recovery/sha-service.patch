+                elif tag in (0x20011, 0x20012):
+                    if pointer % 32:
+                        raise ValueError("unaligned secp")
+                    count = 6 if tag == 0x20011 else 3
+                    data = bytes(uc.mem_read(pointer, count * 32))
+                    values = [
+                        reduce_once(
+                            int.from_bytes(data[i * 32 : (i + 1) * 32], "little")
+                        )
+                        for i in range(count)
+                    ]
+                    result = secp_add(*values) if count == 6 else secp_double(*values)
+                    uc.mem_write(
+                        pointer, b"".join(x.to_bytes(32, "little") for x in result)
+                    )
+                    service_counts[
+                        "secp_add_calls" if count == 6 else "secp_double_calls"
+                    ] += 1
+                elif tag in (0x30001, 0x30002, 0x30003):
+                    words = 4 if tag == 0x30003 else 3
+                    if pointer % 8:
+                        raise ValueError("unaligned bulk packet")
+                    dst, source, length = struct.unpack("<3Q", uc.mem_read(pointer, 24))
+                    if dst % 8 or not 0 < length <= 1 << 20 or length % 8:
+                        raise ValueError("bulk bounds")
+                    spans = [(pointer, pointer + words * 8), (dst, dst + length)]
+                    if tag == 0x30001:
+                        spans.append((source & ~7, (source + length + 7) & ~7))
+                    elif tag == 0x30003:
+                        if source % 8:
+                            raise ValueError("unaligned compare")
+                        spans.append((source, source + length))
+                    for i, a in enumerate(spans):
+                        if not 0 <= a[0] < a[1] <= 1 << 64:
+                            raise ValueError("bulk address overflow")
+                        for b in spans[i + 1 :]:
+                            if a[0] < b[1] and b[0] < a[1]:
+                                raise ValueError("bulk word overlap")
+                    if tag == 0x30001:
+                        uc.mem_write(dst, bytes(uc.mem_read(source, length)))
+                        prefix = (
+                            "bulk_memcpy_unaligned" if source % 8 else "bulk_memcpy"
+                        )
+                        service_counts[prefix + "_calls"] += 1
+                        service_counts[prefix + "_bytes"] += length
+                    elif tag == 0x30002:
+                        uc.mem_write(dst, bytes([source & 255]) * length)
+                        service_counts["bulk_memset_calls"] += 1
+                        service_counts["bulk_memset_bytes"] += length
+                    else:
+                        a = bytes(uc.mem_read(dst, length))
+                        b = bytes(uc.mem_read(source, length))
+                        result = (a > b) - (a < b)
+                        examined = length
+                        for i in range(0, length, 8):
+                            if a[i : i + 8] != b[i : i + 8]:
+                                examined = i + 8
+                                break
+                        uc.mem_write(
+                            pointer + 24,
+                            (result & ((1 << 64) - 1)).to_bytes(8, "little"),
+                        )
+                        service_counts["bulk_memcmp_calls"] += 1
+                        service_counts["bulk_memcmp_bytes"] += examined
+                elif tag == 0x30130:
+                    if pointer % 8:
+                        raise ValueError("unaligned sponge packet")
+                    state_addr, msg, length, flags = struct.unpack(
+                        "<4Q", uc.mem_read(pointer, 32)
+                    )
+                    if (
+                        state_addr % 8
+                        or length >= 1 << 20
+                        or flags & ~3
+                        or not flags & 1
+                        and (not length or length % 136)
+                    ):
+                        raise ValueError("invalid sponge packet")
+                    spans = [(pointer, pointer + 32), (state_addr, state_addr + 200)]
+                    if length:
+                        spans.append((msg & ~7, (msg + length + 7) & ~7))
+                    for i, a in enumerate(spans):
+                        for b in spans[i + 1 :]:
+                            if a[0] < b[1] and b[0] < a[1]:
+                                raise ValueError("sponge word overlap")
+                    lanes = (
+                        [0] * 25
+                        if flags & 2
+                        else list(struct.unpack("<25Q", uc.mem_read(state_addr, 200)))
+                    )
+                    message = bytes(uc.mem_read(msg, length)) if length else b""
+                    for block in range(length // 136 + bool(flags & 1)):
+                        chunk = bytearray(message[block * 136 : (block + 1) * 136])
+                        tail = len(chunk)
+                        chunk.extend(bytes(136 - tail))
+                        if flags & 1 and block == length // 136:
+                            chunk[tail] ^= 1
+                            chunk[135] ^= 0x80
+                        for i, value in enumerate(struct.unpack("<17Q", chunk)):
+                            lanes[i] ^= value
+                        lanes = keccak_f1600(lanes)
+                    uc.mem_write(state_addr, struct.pack("<25Q", *lanes))
+                    service_counts["sponge_calls"] += 1
+                else:
+                    raise ValueError(f"unsupported service tag {tag:#x}")
+                uc.reg_write(R.UC_RISCV_REG_PC, pc)
+            except (ValueError, struct.error, OSError, AttributeError, U.UcError) as error:
+                service_error.append(str(error))
+                uc.emu_stop()
+
+        uc.hook_add(U.UC_HOOK_INTR, service)
+    start = time.monotonic_ns()
+    uc.emu_start(entry, 0, timeout=timeout * 1_000_000, count=expected_steps - 1)
+    if service_error:
+        raise ValueError(service_error[0])
+    if completed or uc.query(U.UC_QUERY_TIMEOUT):
+        raise ValueError("completed early or timed out")
+    uc.emu_start(uc.reg_read(R.UC_RISCV_REG_PC), 0, timeout=1_000_000, count=1)
+    length = int.from_bytes(uc.mem_read(s["output_len"], 4), "little")
+    value = bytes(uc.mem_read(s["output_data"], 43))
+    if service_error:
+        raise ValueError(service_error[0])
+    if not completed or length != 43 or value != expected:
+        raise ValueError("output/count mismatch")
+    return {
+        "schema": "stwo.opstack.unicorn.v1",
+        "oracle": "Unicorn2.1.4",
+        "completed": True,
+        "proof_verified": False,
+        "services": service_counts,
+        "sha256_oracle": sha_compressor.version if service_counts["sha256_calls"] else None,
+        "exact_steps_verified": expected_steps,
+        "elapsed_ns": time.monotonic_ns() - start,
+        "elf_sha256": config["elf_sha256"],
+        "input_sha256": config["input_sha256"],
+        "output": value.hex(),
+        "post_store_pc": halt_pc + 4,
+        "final_registers": [
+            uc.reg_read(getattr(R, f"UC_RISCV_REG_X{i}")) for i in range(32)
+        ],
+        "oracle_source_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+    }
diff --git a/opstack/sha_oracle.py b/opstack/sha_oracle.py
new file mode 100644
--- /dev/null
+++ b/opstack/sha_oracle.py
@@ -0,0 +1,42 @@
+"""Independent SHA-256 compression via OpenSSL 3's public SHA256_Transform ABI.
+
+The producer's Zig service and the guest's Rust implementation are not used.
+SHA256_CTX follows the installed OpenSSL 3 openssl/sha.h (112 bytes). This is
+host-only oracle code; no dynamic library or hint is part of guest execution.
+"""
+import ctypes as C
+from ctypes.util import find_library
+
+
+class Context(C.Structure):
+    _fields_ = [("h", C.c_uint32 * 8), ("Nl", C.c_uint32), ("Nh", C.c_uint32),
+                ("data", C.c_uint32 * 16), ("num", C.c_uint), ("md_len", C.c_uint)]
+
+
+class Compressor:
+    def __init__(self):
+        library = find_library("crypto")
+        if library is None or C.sizeof(Context) != 112:
+            raise ValueError("SHA oracle requires OpenSSL 3 with the public SHA256_CTX ABI")
+        self.lib = C.CDLL(library)
+        self.lib.OpenSSL_version_num.restype = C.c_ulong
+        if self.lib.OpenSSL_version_num() >> 28 != 3:
+            raise ValueError("SHA oracle requires OpenSSL major version 3")
+        self.lib.OpenSSL_version.argtypes = [C.c_int]
+        self.lib.OpenSSL_version.restype = C.c_char_p
+        self.version = self.lib.OpenSSL_version(0).decode("ascii")
+        self.lib.SHA256_Init.argtypes = [C.POINTER(Context)]
+        self.lib.SHA256_Init.restype = C.c_int
+        self.lib.SHA256_Transform.argtypes = [C.POINTER(Context), C.POINTER(C.c_ubyte)]
+        self.lib.SHA256_Transform.restype = None
+
+    def compress(self, state, block):
+        if len(state) != 8 or any(not 0 <= word < 1 << 32 for word in state) or len(block) != 64:
+            raise ValueError("invalid SHA compression input")
+        ctx = Context()
+        if self.lib.SHA256_Init(C.byref(ctx)) != 1:
+            raise ValueError("OpenSSL SHA initialization failed")
+        ctx.h[:] = state
+        data = (C.c_ubyte * 64).from_buffer_copy(block)
+        self.lib.SHA256_Transform(C.byref(ctx), data)
+        return tuple(ctx.h)
diff --git a/opstack/tests/test_sha_oracle.py b/opstack/tests/test_sha_oracle.py
new file mode 100644
--- /dev/null
+++ b/opstack/tests/test_sha_oracle.py
@@ -0,0 +1,42 @@
+import hashlib
+import random
+import struct
+import unittest
+
+from opstack.sha_oracle import Compressor
+
+IV = (0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
+      0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19)
+
+
+class ShaCompression(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.compressor = Compressor()
+
+    def test_public_compression_abi_matches_full_hash_at_padding_boundaries(self):
+        rng = random.Random(20261106)
+        for length in [0, 1, 2, 54, 55, 56, 57, 63, 64, 65, 119, 120, 127, 128, 129, 255, 256, 257, 1024, 4096]:
+            message = rng.randbytes(length)
+            padded = message + b"\x80"
+            padded += bytes((56 - len(padded) % 64) % 64) + (length * 8).to_bytes(8, "big")
+            state = IV
+            for offset in range(0, len(padded), 64):
+                state = self.compressor.compress(state, padded[offset:offset + 64])
+            with self.subTest(length=length):
+                self.assertEqual(struct.pack(">8I", *state), hashlib.sha256(message).digest())
+
+    def test_input_bounds_and_state_ownership(self):
+        state = list(IV)
+        first = self.compressor.compress(state, bytes(64))
+        second = self.compressor.compress(state, bytes(64))
+        self.assertEqual(first, second)
+        self.assertEqual(state, list(IV))
+        for bad_state, block in [(IV[:7], bytes(64)), (IV, bytes(63)),
+                                 ([1 << 32] * 8, bytes(64)), ([-1] * 8, bytes(64))]:
+            with self.assertRaises(ValueError):
+                self.compressor.compress(bad_state, block)
+
+
+if __name__ == "__main__":
+    unittest.main()
