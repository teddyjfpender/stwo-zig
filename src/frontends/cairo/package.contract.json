  "api_surface": [
    "CasmState",
    "Felt252",
    "ProverInput",
    "adapter",
    "air",
    "arena_lifetime",
    "claim_generator",
    "claim_registry",
    "codegen",
    "common",
    "compact_protocol_geometry",
    "compact_verifier_interchange",
    "conformance",
    "preprocessed",
    "proof",
    "proof_plan",
    "proveCairo",
    "prove_trace",
    "prover",
    "proving",
    "rust_oracle",
    "staged_arena_planner",
    "statement",
    "statement_bootstrap",
    "witness",
    "witness_scheduler"
  ],
  "api_contract": {
    "signature_tests": [
      "mod.zig::api signature: Cairo facade preserves statement and prover entry points"
    ],
    "invariant_tests": [
      "prover.zig::Cairo prover: rejects noncanonical Rust oracle identity"
    ]
  },
  "ci": {
    "lane": "cairo_frontend",
