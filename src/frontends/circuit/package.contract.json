{
  "schema": "stwo-zig-package-contract-v2",
  "package": "stwo_circuit_frontend",
  "version": "0.1.0",
  "layer": "frontend",
  "owner": "circuit-frontend",
  "public_modules": {
    "stwo_circuit_frontend": "mod.zig"
  },
  "dependencies": {
    "stwo_core": "../../core"
  },
  "injected_modules": [],
  "api_surface": [
    "air_eval",
    "common",
    "stark_verifier"
  ],
  "api_contract": {
    "signature_tests": [
      "mod.zig::api signature: evaluator tables are built from a parsed projection"
    ],
    "invariant_tests": [
      "mod.zig::projection reader rejects bad magic and truncation"
    ]
  },
  "ci": {
    "lane": "circuit_frontend",
    "host": "linux",
    "command": [
      "zig",
      "build",
      "test",
      "--build-file",
      "src/frontends/circuit/build.zig",
      "-Doptimize=ReleaseFast",
      "-j2"
    ]
  }
}
