use std@1;

// A·B for A = [[a,b],[c,d]] and B = [[2,3],[5,7]].
// All groups are compile-time references; only field arithmetic is proved.
circuit static_matmul(private a: [m31; 1], private b: [m31; 1],
                      private c: [m31; 1], private d: [m31; 1])
    -> public [m31; 1] {
    let left = [[a, b], [c, d]];
    let right = std::array::reshape<2>([
        splat<1>(2_m31), splat<1>(3_m31),
        splat<1>(5_m31), splat<1>(7_m31)]);
    let products = std::math::matmul(left, right);
    let flat = std::array::flatten(products);
    let front = std::array::take<3>(flat);
    let back = std::array::drop<3>(flat);
    let weighted_front = std::math::dot(front, [
        splat<1>(1_m31), splat<1>(2_m31), splat<1>(3_m31)]);
    let weighted_back = std::math::dot(back, [splat<1>(4_m31)]);
    let result = weighted_front + weighted_back;
    result
}
