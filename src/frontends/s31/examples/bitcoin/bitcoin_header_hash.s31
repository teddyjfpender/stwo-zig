use std@1;

// A Bitcoin header is exactly 80 serialized bytes. The hash returned here is
// committed through Poseidon2 because the current public ABI has eight words.
circuit bitcoin_header_hash(private header: Bytes80) -> public Digest<Poseidon2> {
    let hash_bytes = std::hash::sha256d_header(header);
    let hash_limbs = std::bytes::limbs_m31(hash_bytes);
    let root = std::hash::poseidon2_leaf(hash_limbs);
    root
}
