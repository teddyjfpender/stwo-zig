{
  "version": 1,
  "name": "merkle_path1_poseidon",
  "inputs": [
    {"name": "leaf", "kind": "m31", "length": 8, "visibility": "private"},
    {"name": "sibling", "kind": "m31", "length": 8, "visibility": "private"},
    {"name": "direction", "kind": "m31", "length": 1, "visibility": "private"}
  ],
  "nodes": [
    {"name": "digest", "op": "hash_poseidon2_leaf", "lhs": "leaf"},
    {"name": "ordered_left", "op": "select", "lhs": "digest", "rhs": "sibling", "selector": "direction"},
    {"name": "ordered_right", "op": "select", "lhs": "sibling", "rhs": "digest", "selector": "direction"},
    {"name": "root", "op": "hash_poseidon2_pair", "lhs": "ordered_left", "rhs": "ordered_right"}
  ],
  "assertions": [],
  "public_outputs": ["root"]
}
