// The reduced BLAKE2s digest is nominally distinct from Poseidon2.
circuit merkle_path1(
    private leaf: [m31; 8],
    private sibling: Digest<Blake2sReduced>,
    private direction: bit
) -> public Digest<Blake2sReduced> {
    let digest = blake2s_leaf(leaf);
    let ordered_left = select(direction, digest, sibling);
    let ordered_right = select(direction, sibling, digest);
    let root = blake2s_pair(ordered_left, ordered_right);
    root
}
