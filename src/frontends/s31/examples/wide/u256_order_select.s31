use std@1;

// Compare two private 256-bit integers, select their ordered values, and
// commit to their nonnegative distance. All words are little-endian u16.
circuit u256_order_select(private a: UInt256, private b: UInt256) -> public Digest<Poseidon2> {
    let smaller = std::math::min_u256(a, b);
    let larger = std::math::max_u256(a, b);
    let distance = std::math::sub_u256_checked(larger, smaller);

    let less = std::math::lt_u256(a, b);
    let chosen = std::field::select(less, b, a);
    assert_eq(chosen, smaller);
    assert_eq(less, std::math::gt_u256(b, a));
    let equal = std::math::eq_u256(a, b);
    assert_eq(std::math::ne_u256(a, b), std::bool::not(equal));

    let limbs = std::bytes::limbs_m31(distance);
    std::hash::poseidon2_leaf(limbs)
}
