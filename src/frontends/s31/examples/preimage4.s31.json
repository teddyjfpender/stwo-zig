{
  "version": 1,
  "name": "preimage4",
  "inputs": [
    { "name": "target", "kind": "m31", "length": 4, "visibility": "public" },
    { "name": "secret", "kind": "u16", "length": 4, "visibility": "private" }
  ],
  "nodes": [
    { "name": "secret_field", "op": "cast_m31", "lhs": "secret" },
