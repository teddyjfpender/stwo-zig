{
  "schema": "stwo-zig-package-contract-v2",
  "package": "stwo_riscv_frontend",
  "version": "0.1.0",
  "layer": "frontend",
  "owner": "riscv-frontend",
  "public_modules": {
    "stwo_riscv_frontend": "mod.zig"
  },
  "dependencies": {
    "stwo_core": "../../core",
    "stwo_prover_api": "../../prover_api",
    "stwo_prover_engine": "../../prover"
  },
  "injected_modules": [
    "typed_air_artifacts",
    "typed_air_h009_artifacts"
  ],
  "api_surface": [
    "Cpu",
    "HostInterface",
    "HostRuntime",
    "Memory",
    "Opcode",
    "RiscVClaim",
    "access_clock",
    "air",
    "diagnostics",
    "host",
    "infra_trace",
    "isa",
    "opcode_manifest",
    "owned_statement",
    "proveAndVerifyElfWithEngine",
    "proveRiscVTraceOnlyNoPublicIo",
    "proveRiscVWithEngineAndPublicData",
    "prover_mod",
    "runWithHost",
    "runWithInput",
    "runner",
    "testing",
    "verifyRiscVWithEngine",
    "witness_layout"
  ],
  "api_contract": {
    "signature_tests": [
      "mod.zig::api signature: RISC-V facade preserves runner and prover entry points"
    ],
    "invariant_tests": [
      "opcode_coverage_test.zig::all 46 proof opcodes reach witness, semantic, lookup, and component authorities"
    ]
  },
  "ci": {
    "lane": "riscv_frontend",
    "host": "linux",
    "command": [
      "zig",
      "build",
      "test",
      "--build-file",
      "src/frontends/riscv/build.zig",
      "-Doptimize=ReleaseFast",
      "-j2"
    ]
  }
}
