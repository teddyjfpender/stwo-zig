{
  "schema": "stwo-zig-package-contract-v2",
  "package": "stwo_prover_api",
  "version": "0.1.0",
  "layer": "api",
  "owner": "prover-api",
  "public_modules": {
    "stwo_prover_api": "mod.zig"
  },
  "dependencies": {
    "stwo_core": "../core"
  },
  "injected_modules": [],
  "api_surface": [
    "ColumnEvaluation",
    "ColumnSource",
    "CpuCompositionContentionPolicy",
    "CpuCompositionExecutionRequest",
    "DeviceCompositionStage",
    "ProveOptions",
    "QuotientOpsError",
    "assertProverEngine",
    "column",
    "device_composition",
    "engine",
    "stage_profile"
  ],
  "api_contract": {
    "signature_tests": [
      "mod.zig::api signature: prover engine transaction is structurally checked"
    ],
    "invariant_tests": [
      "column.zig::column evaluation validates storage and lifting geometry"
    ]
  },
  "ci": {
    "lane": "prover_api",
    "host": "linux",
    "command": [
      "zig",
      "build",
      "test",
      "--build-file",
      "src/prover_api/build.zig",
      "-Doptimize=ReleaseFast",
      "-j2"
    ]
  }
}
