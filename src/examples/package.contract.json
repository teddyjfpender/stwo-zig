{
  "schema": "stwo-zig-package-contract-v2",
  "package": "stwo_native_examples",
  "version": "0.1.0",
  "layer": "example",
  "owner": "native-examples",
  "public_modules": {
    "stwo_native_examples": "mod.zig"
  },
  "dependencies": {
    "stwo_core": "../core",
    "stwo_cpu_backend": "../backends/cpu_scalar",
    "stwo_proof_wire": "../interop/proof_wire",
    "stwo_prover_api": "../prover_api",
    "stwo_prover_engine": "../prover"
  },
  "injected_modules": [],
  "api_surface": [
    "backend_support",
    "blake",
    "plonk",
    "plonk_logup",
    "poseidon",
    "state_machine",
    "wide_fibonacci",
    "xor"
  ],
  "api_contract": {
    "signature_tests": [
      "mod.zig::api signature: Native example modules expose proving entry points"
    ],
    "invariant_tests": [
      "poseidon.zig::examples poseidon: prove/verify wrapper roundtrip"
    ]
  },
  "ci": {
    "lane": "native_examples",
    "host": "linux",
    "command": [
      "zig",
      "build",
      "test",
      "--build-file",
      "src/examples/build.zig",
      "-Doptimize=ReleaseFast",
      "-j2"
    ]
  }
}
