{
  "schema": "stwo-zig-package-contract-v2",
  "package": "stwo_artifact_store",
  "version": "0.1.0",
  "layer": "service",
  "owner": "artifact-store",
  "public_modules": {
    "stwo_artifact_store": "mod.zig"
  },
  "dependencies": {},
  "injected_modules": [],
  "api_surface": [
    "ArtifactKindV1",
