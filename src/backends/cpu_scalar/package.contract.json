{
  "schema": "stwo-zig-package-contract-v2",
  "package": "stwo_cpu_backend",
  "version": "0.1.0",
  "layer": "backend",
  "owner": "cpu-backend",
  "public_modules": {
    "stwo_cpu_backend": "mod.zig"
  },
  "dependencies": {
    "stwo_backend_contracts": "../../waist/backend",
    "stwo_core": "../../waist/core",
    "stwo_prover_engine": "../../engine/prover"
  },
  "injected_modules": [],
  "api_surface": [
    "CommitmentOptions",
    "CpuBackend",
    "Om31FriBackend",
    "configured"
  ],
  "api_contract": {
    "signature_tests": [
      "mod.zig::cpu_scalar: CpuBackend satisfies backend contract"
    ],
    "invariant_tests": [
      "mod.zig::cpu_scalar: batchInverse delegates correctly"
    ]
  },
  "ci": {
    "lane": "cpu_backend",
    "host": "linux",
    "command": [
      "zig",
      "build",
      "test",
      "--build-file",
      "src/backends/cpu_scalar/build.zig",
      "-Doptimize=ReleaseFast",
      "-j2"
    ]
  }
}
