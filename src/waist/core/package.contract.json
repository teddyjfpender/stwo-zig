{
  "schema": "stwo-zig-package-contract-v3",
  "package": "stwo_core",
  "version": "0.1.0",
  "layer": "protocol",
  "owner": "protocol-core",
  "public_modules": {
    "stwo_core": "mod.zig"
  },
  "dependencies": {},
  "injected_modules": [],
  "api_surface": [
    "ColumnVec",
    "ComponentVec",
    "air",
    "cairo_air_layout",
    "channel",
    "circle",
    "circuit_proof_shape",
    "constraint_framework",
    "constraints",
    "crypto",
    "fft",
    "fields",
    "fraction",
    "fri",
    "pcs",
    "poly",
    "preprocessed_tables",
    "proof",
    "proof_json",
    "proof_of_work",
    "proof_suites",
    "protocol_revision",
    "queries",
    "test_utils",
    "utils",
    "vcs",
    "vcs_lifted",
    "verifier",
    "verifier_types"
  ],
  "api_contract": {
    "signature_tests": [
      "mod.zig::api signature: core vector constructors preserve element types"
    ],
    "invariant_tests": [
      "mod.zig::component vec: flatten and flatten cols"
    ]
  },
  "ci": {
    "lane": "core",
    "host": "linux",
    "command": [
      "zig",
      "build",
      "test",
      "--build-file",
      "src/waist/core/build.zig",
      "-Doptimize=ReleaseFast",
      "-j2"
    ]
  },
  "consumers": [
    {
      "id": "package:stwo_cpu_backend",
      "root": "src/backends/cpu_scalar/contract_tests/stwo_core_test.zig",
      "route": "dependency:stwo_core",
      "imports": [
        "stwo_core",
        "stwo_cpu_backend"
      ],
      "tests": [
        "cdc: CPU batch inverse cleans every allocation failure",
        "cdc: CPU batch inverse owns canonical exact results without changing input",
        "cdc: CPU batch inverse zero refusal preserves input and releases output"
      ]
    }
  ]
}
