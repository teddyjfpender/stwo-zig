{
  "schema": "stwo-zig-package-contract-v2",
  "package": "stwo_proof_wire",
  "version": "0.1.0",
  "layer": "interchange",
  "owner": "proof-wire",
  "public_modules": {
    "stwo_proof_wire": "mod.zig"
  },
  "dependencies": {
    "stwo_core": "../../core"
  },
  "injected_modules": [],
  "api_surface": [
    "CodecError",
    "FriConfigWire",
    "FriLayerWire",
    "FriProofWire",
    "HashWire",
    "Hasher",
    "MerkleDecommitmentWire",
    "PcsConfigWire",
    "Proof",
    "ProofWire",
    "Qm31Wire",
    "decodeProofBytes",
    "decodeProofBytesBinary",
    "encodeProofBytes",
    "encodeProofBytesBinary",
    "encodeProofHexAlloc",
    "proofToWire",
    "wireToProof"
  ],
  "api_contract": {
    "signature_tests": [
      "mod.zig::api signature: proof wire codecs preserve owned byte and proof results"
    ],
    "invariant_tests": [
      "mod.zig::proof wire binary decoder rejects truncation and wrong versions"
    ]
  },
  "ci": {
    "lane": "proof_wire",
    "host": "linux",
    "command": [
      "zig",
      "build",
      "test",
      "--build-file",
      "src/interop/proof_wire/build.zig",
      "-Doptimize=ReleaseFast",
      "-j2"
    ]
  }
}
