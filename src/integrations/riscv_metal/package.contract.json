{
  "schema": "stwo-zig-package-contract-v2",
  "package": "stwo_riscv_metal_integration",
  "version": "0.1.0",
  "layer": "integration",
  "owner": "riscv-metal-integration",
  "public_modules": {
    "stwo_riscv_metal_integration": "mod.zig"
  },
  "dependencies": {
    "stwo_core": "../../core",
    "stwo_metal_backend": "../../backends/metal",
    "stwo_prover_api": "../../prover_api",
    "stwo_prover_engine": "../../prover",
    "stwo_riscv_frontend": "../../frontends/riscv"
  },
  "injected_modules": [],
  "api_surface": [
    "MetalProverEngine",
    "proveAndVerifyElf",
    "proveRiscV",
    "proveRiscVWithPublicData",
    "proveRiscVWithRecorder",
    "verifyRiscV"
  ],
  "api_contract": {
    "signature_tests": [
      "mod.zig::RISC-V Metal engine satisfies the shared prover transaction contract"
    ],
    "invariant_tests": [
      "mod.zig::api invariant: RISC-V Metal integration cannot select the CPU backend"
    ]
  },
  "ci": {
    "lane": "riscv_metal_integration",
    "host": "macos",
    "command": [
      "zig",
      "build",
      "test",
      "--build-file",
      "src/integrations/riscv_metal/build.zig",
      "-Doptimize=ReleaseSafe",
      "-j2"
    ]
  }
}
