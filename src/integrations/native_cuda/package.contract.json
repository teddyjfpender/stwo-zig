{
  "schema": "stwo-zig-package-contract-v2",
  "package": "stwo_native_cuda_integration",
  "version": "0.1.0",
  "layer": "integration",
  "owner": "native-cuda-integration",
  "public_modules": {
    "stwo_native_cuda_integration": "mod.zig"
  },
  "dependencies": {
    "stwo_backend_contracts": "../../backend",
    "stwo_core": "../../core",
    "stwo_cuda_backend": "../../backends/cuda",
    "stwo_native_examples": "../../examples",
    "stwo_proof_wire": "../../interop/proof_wire",
    "stwo_prover_engine": "../../prover"
  },
  "injected_modules": [],
  "api_surface": [
    "blake",
    "common",
    "plonk",
    "plonk_logup",
    "poseidon",
    "state_machine",
    "wide_fibonacci",
    "xor"
  ],
  "api_contract": {
    "signature_tests": [
      "mod.zig::api signature: Native CUDA exposes an owned request and driver boundary"
    ],
    "invariant_tests": [
      "wide_fibonacci/request.zig::admission rejects shapes without a pinned parity contract"
    ]
  },
  "ci": {
    "lane": "native_cuda_integration",
    "host": "linux",
    "command": [
      "zig",
      "build",
      "test",
      "--build-file",
      "src/integrations/native_cuda/build.zig",
      "-Doptimize=ReleaseFast",
      "-j2"
    ]
  }
}
