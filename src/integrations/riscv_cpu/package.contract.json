{
  "schema": "stwo-zig-package-contract-v2",
  "package": "stwo_riscv_cpu_integration",
  "version": "0.1.0",
  "layer": "integration",
  "owner": "riscv-cpu-integration",
  "public_modules": {
    "stwo_riscv_cpu_integration": "mod.zig"
  },
  "dependencies": {
    "stwo_core": "../../core",
    "stwo_cpu_backend": "../../backends/cpu_scalar",
    "stwo_prover_api": "../../prover_api",
    "stwo_prover_engine": "../../prover",
    "stwo_riscv_frontend": "../../frontends/riscv"
  },
  "injected_modules": [
    "build_identity",
    "riscv_cpu_capabilities",
    "stwo"
  ],
  "api_surface": [
    "CpuProverEngine",
    "diagnoseRiscVRelations",
    "proveAndVerifyElf",
    "proveEthereumBlock",
    "proveRiscV",
    "proveRiscVWithPublicData",
    "proveRiscVWithRecorder",
    "verifyRiscV"
  ],
  "api_contract": {
    "signature_tests": [
      "mod.zig::api signature: RISC-V CPU engine satisfies the stable transaction contract"
    ],
    "invariant_tests": [
      "mod.zig::api invariant: RISC-V CPU integration selects only the CPU backend"
    ]
  },
  "ci": {
    "lane": "riscv_cpu_integration",
    "host": "linux",
    "command": [
      "zig",
      "build",
      "test",
      "--build-file",
      "src/integrations/riscv_cpu/build.zig",
      "-Doptimize=ReleaseFast",
      "-j2"
    ]
  }
}
