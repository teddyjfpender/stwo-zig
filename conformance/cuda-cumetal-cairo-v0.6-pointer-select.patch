 )llvm";
 
+constexpr const char* kNvvmPointerSelectPointees = R"llvm(
+target datalayout = "e-p:64:64-i64:64-n16:32:64"
+target triple = "nvptx64-nvidia-cuda"
+%Storage = type { [8 x i32] }
+define ptx_kernel void @pointer_select_pointees(ptr %out, i32 %flag) {
+entry:
+  %left = alloca %Storage, align 4
+  %right = alloca %Storage, align 4
+  %a = getelementptr %Storage, ptr %left, i64 0
+  %b = getelementptr %Storage, ptr %right, i64 0
+  store i32 17, ptr %a, align 4
+  store i32 29, ptr %b, align 4
+  %condition = icmp ne i32 %flag, 0
+  %selected = select i1 %condition, ptr %a, ptr %b
+  %value = load i32, ptr %selected, align 4
+  store i32 %value, ptr %out, align 4
+  ret void
+}
+)llvm";
+
