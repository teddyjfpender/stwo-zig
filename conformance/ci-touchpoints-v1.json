        ["zig", "build", "test", "--build-file", "src/backends/metal/build.zig", "-Doptimize=ReleaseSafe", "-j2"]
      ]
    },
    "riscv_metal_integration": {
      "host": "macos",
      "description": "Independent RISC-V frontend and Metal backend composition package",
      "commands": [
        ["zig", "build", "test", "--build-file", "src/integrations/riscv_metal/build.zig", "-Doptimize=ReleaseSafe", "-j2"]
      ]
    },
    "cairo_metal_integration": {
      "host": "macos",
      "description": "Independent Cairo frontend and Metal backend composition package",
      "commands": [
        ["zig", "build", "test", "--build-file", "src/integrations/cairo_metal/build.zig", "-Doptimize=ReleaseSafe", "-j2"]
      ]
    },
    "metal_session": {
      "host": "linux",
      "description": "Independent persistent Metal-session protocol and artifact package",
      "commands": [
        ["zig", "build", "test", "--build-file", "src/tools/metal_session/build.zig", "-Doptimize=ReleaseFast", "-j2"]
      ]
    },
    "proof_wire": {
      "host": "linux",
      "description": "Independent proof interchange codec package",
      "commands": [
        ["zig", "build", "test", "--build-file", "src/interop/proof_wire/build.zig", "-Doptimize=ReleaseFast", "-j2"]
      ]
    },
    "native_examples": {
      "host": "linux",
      "description": "Independent Native example AIR and reusable-session package",
      "commands": [
        ["zig", "build", "test", "--build-file", "src/examples/build.zig", "-Doptimize=ReleaseFast", "-j2"]
      ]
    },
    "native_cuda_integration": {
      "host": "linux",
      "description": "Independent Native AIR and CUDA backend composition package",
      "commands": [
        ["zig", "build", "test", "--build-file", "src/integrations/native_cuda/build.zig", "-Doptimize=ReleaseFast", "-j2"]
      ]
    },
    "cairo_cuda_integration": {
      "host": "linux",
      "description": "Independent Cairo frontend and CUDA backend composition package",
      "commands": [
        ["zig", "build", "test", "--build-file", "src/integrations/cairo_cuda/build.zig", "-Doptimize=ReleaseFast", "-j2"]
      ]
    },
    "package": {
      "host": "linux",
      "description": "External package consumer compatibility",
      "commands": [
        ["python3", "scripts/check_package_workspace.py"],
        ["zig", "build", "test-downstream-modules", "-Doptimize=ReleaseFast", "-j2"]
      ]
    },
    "native_cpu": {
      "host": "linux",
      "description": "Focused Native CPU/SIMD product",
      "commands": [
        ["zig", "build", "test-native-cpu-product", "stwo-native-cpu", "-Doptimize=ReleaseFast", "-j2"]
      ]
    },
    "native_oracle": {
      "host": "linux",
      "description": "Pinned Rust Stwo interoperability authority",
      "commands": [
        ["python3", "scripts/e2e_interop.py", "--report-out", "{output_dir}/native-oracle.json", "--artifact-dir", "{output_dir}/native-oracle-artifacts", "--archive-dir", "{output_dir}/native-oracle-history"]
      ]
    },
    "riscv_cpu": {
      "host": "linux",
      "description": "Focused RISC-V CPU product, proof production, verification, and trace parity",
      "commands": [
        ["zig", "build", "test-riscv-cpu-product", "stwo-zig-riscv-cpu", "-Doptimize=ReleaseFast", "-j2"],
        ["python3", "scripts/riscv_pr_proof_smoke.py", "--cli", "zig-out/bin/stwo-zig-riscv-cpu", "--artifact-dir", "{output_dir}/riscv-pr-proof-smoke", "--report-out", "{output_dir}/riscv-pr-proof-smoke.json"],
        ["python3", "scripts/riscv_trace_vectors.py"]
      ]
    },
    "cairo_cpu": {
      "host": "linux",
      "local": "hosted",
      "description": "Official Cairo CPU/SIMD frontend, AIR, proof product, and pinned Rust oracle",
      "commands": [
        ["zig", "build", "test-cairo-frontend", "test-cairo-cpu-air", "test-cairo-cpu-proof", "-Doptimize=ReleaseFast", "-j2"],
        ["zig", "build", "test-cairo-cpu-product", "stwo-cairo-cpu", "-Doptimize=ReleaseFast", "-j2"],
        ["zig", "build", "test-cairo-cpu-oracle", "-Doptimize=ReleaseFast", "-j2"]
      ]
    },
    "cairo_metal": {
      "host": "macos",
      "hosted": false,
      "description": "Official Cairo Metal product on a real Metal device with an authenticated external AOT bundle",
      "commands": [
        ["bash", "-ceu", ": \"${STWO_METAL_CORE_AOT_BUNDLE:?explicit authenticated Metal AOT bundle is required}\"\ntest -d \"$STWO_METAL_CORE_AOT_BUNDLE\"\ntest -f \"$STWO_METAL_CORE_AOT_BUNDLE/stwo_zig_core.manifest.json\"\ntest -f \"$STWO_METAL_CORE_AOT_BUNDLE/stwo_zig_core.manifest.sha256\"\ntest -f \"$STWO_METAL_CORE_AOT_BUNDLE/stwo_zig_core.metallib\"\nzig build test-cairo-metal-product stwo-cairo-metal -Doptimize=ReleaseFast -j2 \"-Dmetal-core-aot-bundle=$STWO_METAL_CORE_AOT_BUNDLE\""]
      ]
    },
    "aggregate_cpu": {
      "host": "linux",
      "local": "hosted",
      "description": "CPU aggregate compatibility product",
      "commands": [
        ["zig", "build", "test", "stwo-zig", "-Daggregate-metal=false", "-Doptimize=ReleaseFast", "-j2"],
        ["python3", "scripts/check_registry_parity.py"]
      ]
    },
    "deferred": {
      "host": "linux",
      "description": "Unavailable Cairo/CUDA product policy",
      "commands": [
        ["zig", "test", "build_support/product_policy_test.zig", "-OReleaseFast"]
      ]
    },
    "native_cuda_static": {
      "host": "linux",
      "description": "Native CUDA source, build-plan, runtime, and Rust-adapter contracts without a GPU",
      "commands": [
        ["zig", "build", "cuda-source-closure", "cuda-build-plan", "test-cuda-build-plan", "test-cuda-runtime-contract", "test-cuda-adapter", "-Doptimize=ReleaseFast", "-j2"]
      ]
    },
    "native_cuda_device": {
      "host": "linux",
      "local": "hosted",
      "hosted": false,
      "description": "Native CUDA archive differentials, product residency, CPU parity, and source/lock/toolchain-pinned Rust oracle gate",
      "commands": [
        ["bash", "-ceu", ": \"${STWO_CUDA_NVCC:?explicit STWO_CUDA_NVCC is required}\"\n: \"${STWO_CUDA_HOST_CXX:?explicit STWO_CUDA_HOST_CXX is required}\"\n: \"${STWO_CUDA_HOST_RUNTIME:?explicit STWO_CUDA_HOST_RUNTIME is required}\"\n: \"${STWO_CUDA_HOST_UNWIND_RUNTIME:?explicit STWO_CUDA_HOST_UNWIND_RUNTIME is required}\"\n: \"${STWO_CUDA_AR:?explicit STWO_CUDA_AR is required}\"\n: \"${STWO_CUDA_HOME:?explicit STWO_CUDA_HOME is required}\"\n: \"${STWO_CUDA_LIBRARY_DIR:?explicit STWO_CUDA_LIBRARY_DIR is required}\"\n: \"${STWO_CUDA_ARCH:?explicit STWO_CUDA_ARCH is required}\"\ntest -x \"$STWO_CUDA_NVCC\"\ntest -x \"$STWO_CUDA_HOST_CXX\"\ntest -x \"$STWO_CUDA_AR\"\ntest -f \"$STWO_CUDA_HOST_RUNTIME\"\ntest -f \"$STWO_CUDA_HOST_UNWIND_RUNTIME\"\ntest -d \"$STWO_CUDA_HOME\"\ntest -d \"$STWO_CUDA_LIBRARY_DIR\"\ntest \"$(nvidia-smi --query-gpu=uuid --format=csv,noheader | sed '/^[[:space:]]*$/d' | wc -l | tr -d ' ')\" = 1\nnvidia-smi --query-gpu=name,uuid,compute_cap,driver_version --format=csv,noheader | tee /dev/stderr\nzig build stwo-native-cuda -Doptimize=ReleaseFast -j2 \"-Dcuda-nvcc=$STWO_CUDA_NVCC\" \"-Dcuda-host-cxx=$STWO_CUDA_HOST_CXX\" \"-Dcuda-host-runtime=$STWO_CUDA_HOST_RUNTIME\" \"-Dcuda-host-unwind-runtime=$STWO_CUDA_HOST_UNWIND_RUNTIME\" \"-Dcuda-ar=$STWO_CUDA_AR\" \"-Dcuda-home=$STWO_CUDA_HOME\" \"-Dcuda-library-dir=$STWO_CUDA_LIBRARY_DIR\" \"-Dcuda-arch=$STWO_CUDA_ARCH\"\npython3 scripts/cuda_device_smoke.py --archive zig-out/lib/libstwo_cuda_kernels.a --cuda-home \"$STWO_CUDA_HOME\" --compiler \"$STWO_CUDA_HOST_CXX\" --out-dir \"{output_dir}/native-cuda-device-smoke\"\npython3 -c 'import json,sys; receipt=json.load(open(sys.argv[1], encoding=\"utf-8\")); assert receipt[\"schema\"] == \"stwo-zig-cuda-device-smoke-v1\" and len(receipt[\"tests\"]) == 12' \"{output_dir}/native-cuda-device-smoke/cuda_device_smoke_receipt.json\"\nzig build stwo-native-cpu -Doptimize=ReleaseFast -j2\ncargo +nightly-2025-07-14 build --release --locked --manifest-path tools/stwo-interop-rs/Cargo.toml\nrust_target=\"${CARGO_TARGET_DIR:-tools/stwo-interop-rs/target}\"\nrust_verifier=\"$rust_target/release/stwo-interop-rs\"\ntest -x \"$rust_verifier\"\n# Source, Cargo.lock, and the named Rust toolchain are the oracle pin. This digest binds that built executable into the parity receipt.\nrust_sha256=\"$(sha256sum \"$rust_verifier\" | awk '{print $1}')\"\npython3 scripts/cuda_proof_parity_gate.py --cuda-product zig-out/bin/stwo-zig-native-cuda --native-cpu-product zig-out/bin/stwo-zig-native-cpu --rust-verifier \"$rust_verifier\" --rust-verifier-sha256 \"$rust_sha256\" --log-n-rows 5 --sequence-len 8 --repeat 3 --out-dir \"{output_dir}/native-cuda-parity\"\npython3 scripts/cuda_proof_parity_gate.py --cuda-product zig-out/bin/stwo-zig-native-cuda --native-cpu-product zig-out/bin/stwo-zig-native-cpu --rust-verifier \"$rust_verifier\" --rust-verifier-sha256 \"$rust_sha256\" --air poseidon --log-n-instances 10 --repeat 3 --execution-mode graphs --out-dir \"{output_dir}/native-cuda-poseidon-graphs\"\npython3 scripts/cuda_proof_parity_gate.py --cuda-product zig-out/bin/stwo-zig-native-cuda --native-cpu-product zig-out/bin/stwo-zig-native-cpu --rust-verifier \"$rust_verifier\" --rust-verifier-sha256 \"$rust_sha256\" --air poseidon --log-n-instances 10 --repeat 3 --execution-mode direct --out-dir \"{output_dir}/native-cuda-poseidon-direct\"\npython3 -c 'import json,sys; a=json.load(open(sys.argv[1], encoding=\"utf-8\")); b=json.load(open(sys.argv[2], encoding=\"utf-8\")); assert a[\"proofs\"][\"cuda\"][\"proof_sha256\"] == b[\"proofs\"][\"cuda\"][\"proof_sha256\"] and a[\"cuda_residency\"][\"aot_build_sha256\"] == b[\"cuda_residency\"][\"aot_build_sha256\"]' \"{output_dir}/native-cuda-poseidon-graphs/receipt.json\" \"{output_dir}/native-cuda-poseidon-direct/receipt.json\"\ntest -s \"{output_dir}/native-cuda-parity/receipt.json\"\ntest -s \"{output_dir}/native-cuda-poseidon-graphs/receipt.json\"\ntest -s \"{output_dir}/native-cuda-poseidon-direct/receipt.json\""]
      ]
    },
    "native_metal": {
      "host": "macos",
      "hosted": false,
