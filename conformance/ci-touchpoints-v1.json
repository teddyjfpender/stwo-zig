    "native_cuda_device": {
      "host": "linux",
      "local": "hosted",
      "hosted": false,
      "description": "Native CUDA archive differentials, product residency, CPU parity, and source/lock/toolchain-pinned Rust oracle gate",
      "commands": [
        [
          "bash",
          "-ceu",
          ": \"${STWO_CUDA_NVCC:?explicit STWO_CUDA_NVCC is required}\"\n: \"${STWO_CUDA_HOST_CXX:?explicit STWO_CUDA_HOST_CXX is required}\"\n: \"${STWO_CUDA_HOST_RUNTIME:?explicit STWO_CUDA_HOST_RUNTIME is required}\"\n: \"${STWO_CUDA_HOST_UNWIND_RUNTIME:?explicit STWO_CUDA_HOST_UNWIND_RUNTIME is required}\"\n: \"${STWO_CUDA_AR:?explicit STWO_CUDA_AR is required}\"\n: \"${STWO_CUDA_HOME:?explicit STWO_CUDA_HOME is required}\"\n: \"${STWO_CUDA_LIBRARY_DIR:?explicit STWO_CUDA_LIBRARY_DIR is required}\"\n: \"${STWO_CUDA_ARCH:?explicit STWO_CUDA_ARCH is required}\"\ntest -x \"$STWO_CUDA_NVCC\"\ntest -x \"$STWO_CUDA_HOST_CXX\"\ntest -x \"$STWO_CUDA_AR\"\ntest -f \"$STWO_CUDA_HOST_RUNTIME\"\ntest -f \"$STWO_CUDA_HOST_UNWIND_RUNTIME\"\ntest -d \"$STWO_CUDA_HOME\"\ntest -d \"$STWO_CUDA_LIBRARY_DIR\"\ntest \"$(nvidia-smi --query-gpu=uuid --format=csv,noheader | sed '/^[[:space:]]*$/d' | wc -l | tr -d ' ')\" = 1\nnvidia-smi --query-gpu=name,uuid,compute_cap,driver_version --format=csv,noheader | tee /dev/stderr\nzig build stwo-native-cuda -Doptimize=ReleaseFast -j2 \"-Dcuda-nvcc=$STWO_CUDA_NVCC\" \"-Dcuda-host-cxx=$STWO_CUDA_HOST_CXX\" \"-Dcuda-host-runtime=$STWO_CUDA_HOST_RUNTIME\" \"-Dcuda-host-unwind-runtime=$STWO_CUDA_HOST_UNWIND_RUNTIME\" \"-Dcuda-ar=$STWO_CUDA_AR\" \"-Dcuda-home=$STWO_CUDA_HOME\" \"-Dcuda-library-dir=$STWO_CUDA_LIBRARY_DIR\" \"-Dcuda-arch=$STWO_CUDA_ARCH\"\npython3 scripts/cuda_device_smoke.py --archive zig-out/lib/libstwo_cuda_kernels.a --cuda-home \"$STWO_CUDA_HOME\" --compiler \"$STWO_CUDA_HOST_CXX\" --out-dir \"{output_dir}/native-cuda-device-smoke\"\npython3 -c 'import json,sys; receipt=json.load(open(sys.argv[1], encoding=\"utf-8\")); assert receipt[\"schema\"] == \"stwo-zig-cuda-device-smoke-v1\" and len(receipt[\"tests\"]) == 12' \"{output_dir}/native-cuda-device-smoke/cuda_device_smoke_receipt.json\"\nzig build stwo-native-cpu -Doptimize=ReleaseFast -j2\ncargo +nightly-2025-07-14 build --release --locked --manifest-path tools/stwo-interop-rs/Cargo.toml\nrust_target=\"${CARGO_TARGET_DIR:-tools/stwo-interop-rs/target}\"\nrust_verifier=\"$rust_target/release/stwo-interop-rs\"\ntest -x \"$rust_verifier\"\n# Source, Cargo.lock, and the named Rust toolchain are the oracle pin. This digest binds that built executable into the parity receipt.\nrust_sha256=\"$(sha256sum \"$rust_verifier\" | awk '{print $1}')\"\npython3 scripts/cuda_proof_parity_gate.py --cuda-product zig-out/bin/stwo-zig-native-cuda --native-cpu-product zig-out/bin/stwo-zig-native-cpu --rust-verifier \"$rust_verifier\" --rust-verifier-sha256 \"$rust_sha256\" --log-n-rows 5 --sequence-len 8 --repeat 3 --out-dir \"{output_dir}/native-cuda-parity\"\npython3 scripts/cuda_proof_parity_gate.py --cuda-product zig-out/bin/stwo-zig-native-cuda --native-cpu-product zig-out/bin/stwo-zig-native-cpu --rust-verifier \"$rust_verifier\" --rust-verifier-sha256 \"$rust_sha256\" --air poseidon --log-n-instances 10 --repeat 3 --execution-mode graphs --out-dir \"{output_dir}/native-cuda-poseidon-graphs\"\npython3 scripts/cuda_proof_parity_gate.py --cuda-product zig-out/bin/stwo-zig-native-cuda --native-cpu-product zig-out/bin/stwo-zig-native-cpu --rust-verifier \"$rust_verifier\" --rust-verifier-sha256 \"$rust_sha256\" --air poseidon --log-n-instances 10 --repeat 3 --execution-mode direct --out-dir \"{output_dir}/native-cuda-poseidon-direct\"\npython3 -c 'import json,sys; a=json.load(open(sys.argv[1], encoding=\"utf-8\")); b=json.load(open(sys.argv[2], encoding=\"utf-8\")); assert a[\"proofs\"][\"cuda\"][\"proof_sha256\"] == b[\"proofs\"][\"cuda\"][\"proof_sha256\"] and a[\"cuda_residency\"][\"aot_build_sha256\"] == b[\"cuda_residency\"][\"aot_build_sha256\"]' \"{output_dir}/native-cuda-poseidon-graphs/receipt.json\" \"{output_dir}/native-cuda-poseidon-direct/receipt.json\"\ntest -s \"{output_dir}/native-cuda-parity/receipt.json\"\ntest -s \"{output_dir}/native-cuda-poseidon-graphs/receipt.json\"\ntest -s \"{output_dir}/native-cuda-poseidon-direct/receipt.json\""
        ]
      ]
    },
