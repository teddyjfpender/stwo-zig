        ["zig", "build", "test", "--build-file", "src/integrations/riscv_cpu/build.zig", "-Doptimize=ReleaseFast", "-j2"]
      ]
    },
    "cairo_cpu_integration": {
      "host": "linux",
      "description": "Independent Cairo frontend and CPU backend composition package",
