{
  "schema": "ci-touchpoints-v1",
  "always_lanes": ["static"],
  "lanes": {
    "static": {
      "host": "linux",
      "description": "Formatting, policy, and Python contract tests",
      "commands": [
        ["zig", "fmt", "--check", "build.zig", "build_support", "src", "tools"],
        ["python3", "-m", "unittest", "discover", "-s", "scripts/tests", "-p", "test_*.py"],
        ["python3", "scripts/check_build_monorepo_baseline.py"],
        ["python3", "scripts/check_source_conformance.py"],
        ["python3", "scripts/check_package_workspace.py"],
        ["python3", "scripts/check_upstream_pins.py"]
      ]
    },
    "build_graph": {
      "host": "linux",
      "local": "hosted",
      "description": "Catalog construction and build-identity boundaries",
      "commands": [
        ["python3", "scripts/check_build_configure_closure.py"],
        ["zig", "test", "build_support/product_policy_test.zig", "-OReleaseFast"],
        ["zig", "test", "build_support/identity_test.zig", "-OReleaseFast"]
      ]
    },
    "core": {
      "host": "linux",
      "description": "Focused Stwo core library",
      "commands": [
        ["zig", "build", "test-stwo-core", "identity-stwo-core", "-Doptimize=ReleaseFast", "-j2"],
        ["zig", "build", "test", "--build-file", "src/core/build.zig", "-Doptimize=ReleaseFast", "-j2"]
      ]
    },
    "backend_contracts": {
      "host": "linux",
      "description": "Independent backend-contracts package",
      "commands": [
        ["zig", "build", "test", "--build-file", "src/backend/build.zig", "-Doptimize=ReleaseFast", "-j2"]
      ]
    },
    "prover": {
      "host": "linux",
      "description": "Focused backend-generic prover library",
      "commands": [
        ["zig", "build", "test-stwo-prover", "identity-stwo-prover", "-Doptimize=ReleaseFast", "-j2"],
        ["zig", "build", "test", "--build-file", "src/prover/build.zig", "-Doptimize=ReleaseFast", "-j2"]
      ]
    },
    "prover_api": {
      "host": "linux",
      "description": "Stable prover transaction API and observability contracts",
      "commands": [
        ["zig", "build", "test", "--build-file", "src/prover_api/build.zig", "-Doptimize=ReleaseFast", "-j2"]
      ]
    },
    "riscv_frontend": {
      "host": "linux",
      "description": "Independent Sail-authoritative RISC-V frontend package",
      "commands": [
        ["zig", "build", "test", "--build-file", "src/frontends/riscv/build.zig", "-Doptimize=ReleaseFast", "-j2"]
      ]
    },
    "riscv_cpu_integration": {
      "host": "linux",
      "description": "Independent RISC-V frontend and CPU backend composition package",
